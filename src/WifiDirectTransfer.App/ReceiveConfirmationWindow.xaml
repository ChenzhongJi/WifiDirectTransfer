<Window x:Class="WifiDirectTransfer.App.ReceiveConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="接收文件确认"
        Width="460"
        Height="330"
        MinWidth="420"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F3F3F3"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="收到文件传输请求"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="#1B1B1B" />

        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Padding="16"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel>
                <TextBlock Text="发送端"
                           FontSize="12"
                           Foreground="#707070" />
                <TextBlock x:Name="SenderNameText"
                           Margin="0,4,0,0"
                           FontSize="16"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="SenderIdText"
                           Margin="0,4,0,0"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="#616161"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="CountdownText"
                   Grid.Row="2"
                   Margin="0,16,0,0"
                   FontSize="14"
                   Foreground="#B54708"
                   Text="15 秒后自动拒绝" />

        <TextBlock Grid.Row="3"
                   Margin="0,12,0,0"
                   Foreground="#707070"
                   TextWrapping="Wrap"
                   Text="接受后，接收端会先完成连接确认，然后等待文件数据。" />

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="拒绝"
                    IsCancel="True"
                    MinWidth="88"
                    Padding="16,6"
                    Margin="0,0,8,0"
                    Click="RejectButton_Click" />
            <Button Content="接受"
                    MinWidth="88"
                    Padding="16,6"
                    Click="AcceptButton_Click" />
        </StackPanel>
    </Grid>
</Window>
