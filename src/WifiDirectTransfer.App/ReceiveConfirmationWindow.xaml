<Window x:Class="WifiDirectTransfer.App.ReceiveConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="接收文件确认"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="460"
        Height="330"
        MinWidth="420"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Style="{StaticResource DialogWindowStyle}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource DialogTitleText}"
                   Text="收到文件传输请求" />

        <Border Grid.Row="1"
                Margin="0,12,0,0"
                Style="{StaticResource DialogCardBorder}">
            <StackPanel>
                <TextBlock Style="{StaticResource DialogHintText}"
                           Text="发送端" />
                <TextBlock x:Name="SenderNameText"
                           Margin="0,4,0,0"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="SenderIdText"
                           Margin="0,4,0,0"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="10.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="CountdownText"
                   Grid.Row="2"
                   Margin="0,12,0,0"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource WarningBrush}"
                   Text="15 秒后自动拒绝" />

        <TextBlock Grid.Row="3"
                   Margin="0,8,0,0"
                   Style="{StaticResource DialogBodyText}"
                   Text="接受后，双方都可以发送和接收文件。" />

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="拒绝"
                    IsCancel="True"
                    MinWidth="88"
                    Margin="0,0,8,0"
                    Click="RejectButton_Click" />
            <Button Content="接受"
                    MinWidth="88"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="AcceptButton_Click" />
        </StackPanel>
    </Grid>
</Window>
