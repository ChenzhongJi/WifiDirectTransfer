<Window x:Class="WifiDirectTransfer.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="580"
        Height="480"
        MinWidth="500"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F3F3F3"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Wi-Fi Direct 文件传输"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#1B1B1B" />
            <TextBlock Text="点对点文件与剪贴板传输 · 无需互联网"
                       Margin="0,6,0,0"
                       Foreground="#616161" />
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Margin="0,16,0,0"
                   Foreground="#707070"
                   TextWrapping="Wrap"
                   Text="以下信息可用于反馈问题，不包含文件内容。" />

        <TextBox x:Name="DetailsTextBox"
                 Grid.Row="2"
                 Margin="0,10,0,0"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12"
                 Background="#FAFAFA"
                 BorderBrush="#E0E0E0"
                 Padding="10" />

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Button x:Name="CopyButton"
                    HorizontalAlignment="Left"
                    Content="复制信息"
                    MinWidth="96"
                    Padding="16,6"
                    Click="CopyButton_Click" />
            <Button HorizontalAlignment="Right"
                    Content="关闭"
                    IsCancel="True"
                    MinWidth="88"
                    Padding="16,6" />
        </Grid>
    </Grid>
</Window>
