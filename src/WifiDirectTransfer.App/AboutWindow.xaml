<Window x:Class="WifiDirectTransfer.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="580"
        Height="480"
        MinWidth="500"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Style="{StaticResource DialogWindowStyle}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource DialogProductTitleText}"
                       Text="Wi-Fi Direct 文件传输" />
            <TextBlock Margin="0,4,0,0"
                       Style="{StaticResource DialogSubtitleText}"
                       Text="点对点文件与剪贴板传输 · 无需互联网" />
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Margin="0,14,0,0"
                   Style="{StaticResource DialogBodyText}"
                   Text="以下信息可用于反馈问题，不包含文件内容。" />

        <TextBox x:Name="DetailsTextBox"
                 Grid.Row="2"
                 Margin="0,10,0,0"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Style="{StaticResource MonoTextBoxStyle}" />

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                <Button x:Name="CopyButton"
                        Content="复制信息"
                        MinWidth="96"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="CopyButton_Click" />
                <Button x:Name="CheckUpdateButton"
                        Margin="8,0,0,0"
                        Content="检查更新"
                        MinWidth="96"
                        Click="CheckUpdateButton_Click" />
            </StackPanel>
            <Button HorizontalAlignment="Right"
                    Content="关闭"
                    IsCancel="True"
                    MinWidth="88" />
        </Grid>
    </Grid>
</Window>
