<Window x:Class="WifiDirectTransfer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wi-Fi Direct 文件传输"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1120"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDrop="Window_PreviewDrop"
        Loaded="OnLoaded"
        Closing="OnClosing">
    <Window.Resources>
        <Style x:Key="TransferTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#616161" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder"
                                Margin="0,0,8,0"
                                Padding="14,6"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="BorderBrush"
                                        Value="#0B5CAD" />
                                <Setter Property="Foreground" Value="#0B5CAD" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="#F0F4FA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Wi-Fi Direct 文件传输"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#1B1B1B" />
                <TextBlock Text="M1 · PeerFinder + StreamSocket"
                           Margin="0,4,0,0"
                           Foreground="#616161" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Ellipse x:Name="CapabilityDot"
                         Width="10"
                         Height="10"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         Fill="#8A8A8A" />
                <TextBlock x:Name="CapabilityText"
                           MaxWidth="520"
                           Text="正在检查 Wi-Fi Direct 能力…"
                           TextAlignment="Right"
                           TextWrapping="Wrap"
                           Foreground="#616161" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Background="White"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="连接角色"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#1B1B1B" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <RadioButton x:Name="RoleReceiverRadio"
                                             GroupName="Role"
                                             Content="作为等待连接端"
                                             Margin="0,0,24,0"
                                             Checked="RoleRadio_Checked" />
                                <RadioButton x:Name="RoleSenderRadio"
                                             GroupName="Role"
                                             Content="作为连接发起端"
                                             Checked="RoleRadio_Checked" />
                            </StackPanel>
                            <TextBlock Text="连接成功后双方都可以发送和接收文件。"
                                       Margin="0,8,0,0"
                                       Foreground="#707070"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Background="White"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="设备"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#1B1B1B"
                                           VerticalAlignment="Center" />
                                <Button x:Name="ScanButton"
                                        HorizontalAlignment="Right"
                                        Padding="12,4"
                                        Content="扫描设备"
                                        Click="ScanButton_Click" />
                            </Grid>

                            <ListBox x:Name="PeerList"
                                     Height="140"
                                     Margin="0,10,0,0"
                                     Background="#FFFFFF"
                                     BorderBrush="#E0E0E0"
                                     SelectionChanged="PeerList_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,6">
                                            <TextBlock Text="{Binding DisplayNameText}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DetailText}"
                                                       Margin="0,2,0,0"
                                                       FontSize="11"
                                                       Foreground="#707070"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ConnectButton"
                                        Padding="12,6"
                                        Content="连接选中设备"
                                        Click="ConnectButton_Click" />
                                <Button x:Name="QuickReconnectButton"
                                        Grid.Column="2"
                                        Padding="12,6"
                                        Content="快速重连"
                                        Click="QuickReconnectButton_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="White"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Text="操作"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#1B1B1B" />

                            <Button x:Name="WaitButton"
                                    Margin="0,10,0,0"
                                    Padding="12,6"
                                    Content="等待连接"
                                    Click="WaitButton_Click" />

                            <Button x:Name="SendTestFileButton"
                                    Margin="0,6,0,0"
                                    Padding="12,6"
                                    Content="发送测试文件（1 MiB）"
                                    Click="SendTestFileButton_Click" />

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="SendTextButton"
                                        Padding="12,6"
                                        Content="发送文本"
                                        Click="SendTextButton_Click" />
                                <Button x:Name="TextInboxButton"
                                        Grid.Column="2"
                                        Padding="12,6"
                                        Content="收到的文本"
                                        Click="TextInboxButton_Click" />
                            </Grid>

                            <CheckBox x:Name="ClipboardSyncCheckBox"
                                      Margin="0,12,0,0"
                                      Content="启用剪贴板同步"
                                      Checked="ClipboardSyncCheckBox_Checked"
                                      Unchecked="ClipboardSyncCheckBox_Unchecked" />
                            <TextBlock Text="对端可看到你复制的内容。大图片可能不会出现在 Win+V 历史里，直接粘贴正常。"
                                       Margin="0,4,0,0"
                                       FontSize="11"
                                       Foreground="#707070"
                                       TextWrapping="Wrap" />

                            <CheckBox x:Name="TextReceiveCheckBox"
                                      Margin="0,12,0,0"
                                      Content="允许接收远程文本"
                                      Checked="TextReceiveCheckBox_Checked"
                                      Unchecked="TextReceiveCheckBox_Unchecked" />
                            <TextBlock Text="对端发送的文本会显示在文本收件箱中，默认关闭。"
                                       Margin="0,4,0,0"
                                       FontSize="11"
                                       Foreground="#707070"
                                       TextWrapping="Wrap" />

                            <StackPanel x:Name="SameNamePolicyPanel"
                                        Margin="0,12,0,0"
                                        Visibility="Collapsed">
                                <TextBlock Text="同名文件"
                                           FontSize="12"
                                           Foreground="#616161" />
                                <ComboBox x:Name="SameNamePolicyComboBox"
                                          Margin="0,4,0,0"
                                          SelectedIndex="0"
                                          SelectionChanged="SameNamePolicyComboBox_SelectionChanged">
                                    <ComboBoxItem Content="自动重命名（追加 (1)、(2)）"
                                                  Tag="AutoRename" />
                                    <ComboBoxItem Content="覆盖"
                                                  Tag="Overwrite" />
                                    <ComboBoxItem Content="跳过"
                                                  Tag="Skip" />
                                </ComboBox>
                            </StackPanel>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ReceiveDirectoryText"
                                           FontSize="11"
                                           Foreground="#707070"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                                <Button x:Name="ChangeReceiveDirectoryButton"
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Padding="8,2"
                                        Content="更改…"
                                        Click="ChangeReceiveDirectoryButton_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="260" />
                    <RowDefinition x:Name="LogRow"
                                   Height="200"
                                   MinHeight="120" />
                </Grid.RowDefinitions>

                <Border Background="White"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="SendTabButton"
                                         Content="发送"
                                         Style="{StaticResource TransferTabStyle}"
                                         GroupName="TransferTabs"
                                         IsChecked="True"
                                         Checked="TransferTab_Checked" />
                            <RadioButton x:Name="ReceiveTabButton"
                                         Content="接收"
                                         Style="{StaticResource TransferTabStyle}"
                                         GroupName="TransferTabs"
                                         Checked="TransferTab_Checked" />
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid x:Name="SendPanel">
                                <Grid x:Name="QueuePanel">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock Text="传输队列"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#1B1B1B"
                                       VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button x:Name="AddQueueFilesButton"
                                        Padding="10,2"
                                        Content="添加文件…"
                                        Click="AddQueueFilesButton_Click" />
                                <Button x:Name="StartQueueButton"
                                        Margin="6,0,0,0"
                                        Padding="10,2"
                                        Content="开始传输"
                                        Click="StartQueueButton_Click" />
                                <Button x:Name="ClearQueueButton"
                                        Margin="6,0,0,0"
                                        Padding="10,2"
                                        Content="清空"
                                        Click="ClearQueueButton_Click" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding CurrentPositionText}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CurrentFile.FileName, TargetNullValue=尚未开始, FallbackValue=尚未开始}"
                                           Margin="0,2,0,0"
                                           Foreground="#1B1B1B"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Foreground="#707070"
                                       Text="{Binding CurrentFile.StatusText, TargetNullValue=等待添加文件, FallbackValue=等待添加文件}" />
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="当前文件"
                                           FontSize="11"
                                           Foreground="#707070" />
                                <ProgressBar Height="8"
                                             Margin="0,4,0,0"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding CurrentFile.ProgressPercent, Mode=OneWay, FallbackValue=0}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Grid>
                                    <TextBlock Text="总体进度"
                                               FontSize="11"
                                               Foreground="#707070" />
                                    <TextBlock HorizontalAlignment="Right"
                                               FontSize="11"
                                               Foreground="#707070"
                                               Text="{Binding OverallProgressText}" />
                                </Grid>
                                <ProgressBar Height="8"
                                             Margin="0,4,0,0"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding OverallProgressPercent, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <ListBox x:Name="QueueList"
                                     MinHeight="80"
                                     ItemsSource="{Binding Files}"
                                     Background="#FFFFFF"
                                     BorderBrush="#E0E0E0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding FileName}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding SourcePath}" />
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,2,0,0">
                                                    <TextBlock FontSize="11"
                                                               Foreground="#707070"
                                                               Text="{Binding Size, StringFormat={}{0:N0} 字节}" />
                                                    <TextBlock FontSize="11"
                                                               Foreground="#707070"
                                                               Text=" · " />
                                                    <TextBlock FontSize="11"
                                                               Text="{Binding StatusText}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#707070" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Transferring">
                                                                        <Setter Property="Foreground" Value="#0B5CAD" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                        <Setter Property="Foreground" Value="#1B7F3B" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                        <Setter Property="Foreground" Value="#B3261E" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="11"
                                                           Foreground="#B3261E"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding ErrorMessage}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <ProgressBar Grid.Column="1"
                                                         Width="90"
                                                         Height="6"
                                                         Margin="12,0,0,0"
                                                         VerticalAlignment="Center"
                                                         Minimum="0"
                                                         Maximum="100"
                                                         Value="{Binding ProgressPercent, Mode=OneWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock x:Name="QueueEmptyText"
                                       Text="尚未添加文件，连接后可添加或拖入。"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#8A8A8A"
                                       IsHitTestVisible="False" />
                        </Grid>
                                </Grid>
                            </Grid>

                            <Grid x:Name="ReceivePanel" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border x:Name="CurrentReceivePanel"
                                        Margin="0,0,0,12"
                                        Padding="12"
                                        Background="#F2F7FF"
                                        BorderBrush="#C9DCF3"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="正在接收"
                                                   FontSize="11"
                                                   Foreground="#0B5CAD" />
                                        <TextBlock Grid.Row="1"
                                                   Margin="0,4,0,0"
                                                   Text="{Binding FileName}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="2"
                                                   Margin="0,4,0,0"
                                                   Text="{Binding DetailText}"
                                                   FontSize="11"
                                                   Foreground="#616161"
                                                   TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Grid.Row="3"
                                                     Height="8"
                                                     Margin="0,6,0,0"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding ProgressPercent, Mode=OneWay}" />
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <TextBlock Text="本次已接收文件"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#1B1B1B"
                                               VerticalAlignment="Center" />
                                    <TextBlock HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               Foreground="#707070"
                                               Text="可拖出" />
                                </Grid>

                                <ListBox x:Name="ReceivedFilesList"
                                         Grid.Row="2"
                                         SelectionMode="Extended"
                                         Background="#FFFFFF"
                                         BorderBrush="#E0E0E0"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         PreviewMouseLeftButtonDown="ReceivedFilesList_PreviewMouseLeftButtonDown"
                                         PreviewMouseLeftButtonUp="ReceivedFilesList_PreviewMouseLeftButtonUp"
                                         MouseMove="ReceivedFilesList_MouseMove">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4,4">
                                                <TextBlock Text="{Binding FileName}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding FilePath}" />
                                                <TextBlock Text="{Binding DetailText}"
                                                           Margin="0,2,0,0"
                                                           FontSize="11"
                                                           Foreground="#707070"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock x:Name="ReceivedFilesEmptyText"
                                           Grid.Row="3"
                                           Margin="0,6,0,0"
                                           FontSize="11"
                                           Foreground="#8A8A8A"
                                           Text="接收到的文件会显示在这里，可直接拖到资源管理器。" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="LogPanel"
                        Grid.Row="1"
                        Margin="0,12,0,0"
                        Background="White"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="日志"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#1B1B1B"
                                       VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button x:Name="LogToggleButton"
                                        Padding="10,2"
                                        Content="折叠"
                                        ToolTip="折叠或展开日志"
                                        Click="LogToggleButton_Click" />
                                <Button x:Name="HistoryButton"
                                        Margin="6,0,0,0"
                                        Padding="10,2"
                                        Content="传输历史"
                                        Click="HistoryButton_Click" />
                                <Button x:Name="ExportDiagnosticsButton"
                                        Margin="6,0,0,0"
                                        Padding="10,2"
                                        Content="导出诊断"
                                        Click="ExportDiagnosticsButton_Click" />
                                <Button x:Name="AboutButton"
                                        Margin="6,0,0,0"
                                        Padding="10,2"
                                        Content="关于"
                                        Click="AboutButton_Click" />
                                <Button x:Name="ClearLogButton"
                                        Margin="6,0,0,0"
                                        Padding="10,2"
                                        Content="清空"
                                        Click="ClearLogButton_Click" />
                            </StackPanel>
                        </Grid>

                        <TextBox x:Name="LogTextBox"
                                 Grid.Row="1"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Background="#FAFAFA"
                                 BorderBrush="#E0E0E0"
                                 Padding="10" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText"
                       Text="未连接"
                       FontWeight="SemiBold"
                       Foreground="#1B1B1B" />
            <TextBlock HorizontalAlignment="Right"
                       Text="M1 · 双向传输"
                       FontSize="12"
                       Foreground="#8A8A8A" />
        </Grid>
    </Grid>
</Window>
