<Window x:Class="WifiDirectTransfer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wi-Fi Direct 文件传输"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1120"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDrop="Window_PreviewDrop"
        Loaded="OnLoaded"
        Closing="OnClosing">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}" />

        <Geometry x:Key="FileIconGeometry">M4,1.8 H9.5 L13,5.3 V14.2 H4 Z M9.5,1.8 V5.3 H13</Geometry>
        <Geometry x:Key="DeviceIconGeometry">M2.5,3.5 H13.5 V11 H2.5 Z M1.5,13.5 H14.5</Geometry>
        <Geometry x:Key="FolderIconGeometry">M1.8,4.2 H6.2 L7.6,6.1 H14.2 V12.8 H1.8 Z</Geometry>

        <Style x:Key="SmallGlyphPath" TargetType="Path">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="StrokeThickness" Value="1.2" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
        </Style>

        <Style x:Key="QueueStatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Transferring">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Skipped">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QueueProgressBarStyle"
               TargetType="ProgressBar"
               BasedOn="{StaticResource {x:Type ProgressBar}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Skipped">
                    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CurrentStatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentFile.Status}" Value="Transferring">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentFile.Status}" Value="Completed">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentFile.Status}" Value="Failed">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- 顶部状态栏：连接状态 + 能力状态 -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border x:Name="ConnectionChip"
                            Padding="10,4"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SurfaceAltBrush}"
                            CornerRadius="14">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ConnectionDot"
                                     Width="7"
                                     Height="7"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock x:Name="ConnectionStatusText"
                                       Margin="7,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Text="未连接" />
                            <Border Width="1"
                                    Height="12"
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource WindowBorderBrush}" />
                            <TextBlock x:Name="ConnectionPeerText"
                                       MaxWidth="220"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="选择设备并连接"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="DisconnectButton"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="断开连接"
                            Content="断开"
                            Style="{StaticResource SmallButtonStyle}"
                            ToolTip="断开当前连接"
                            Visibility="Collapsed"
                            Click="DisconnectButton_Click" />
                </StackPanel>

                <TextBlock x:Name="ConnectionHintText"
                           Grid.Column="1"
                           Margin="16,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Text="连接后双方都可以发送和接收文件"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse x:Name="CapabilityDot"
                             Width="8"
                             Height="8"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource TextTertiaryBrush}" />
                    <TextBlock x:Name="CapabilityText"
                               MaxWidth="360"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="正在检查 Wi-Fi Direct 能力…"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：连接与设备 -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer x:Name="LeftRailScrollViewer"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,16,14,16">
                        <TextBlock Style="{StaticResource SectionLabelText}"
                                   Text="连接方式" />
                        <Border Margin="0,6,0,0"
                                Padding="2"
                                Background="{DynamicResource SegmentBackgroundBrush}"
                                CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="RoleReceiverRadio"
                                             GroupName="Role"
                                             Content="等待连接"
                                             Style="{StaticResource SegmentRadioStyle}"
                                             Checked="RoleRadio_Checked" />
                                <RadioButton x:Name="RoleSenderRadio"
                                             Grid.Column="1"
                                             GroupName="Role"
                                             Content="连接设备"
                                             Style="{StaticResource SegmentRadioStyle}"
                                             Checked="RoleRadio_Checked" />
                            </Grid>
                        </Border>
                        <Grid Margin="0,14,0,8">
                            <TextBlock Style="{StaticResource SectionTitleText}"
                                       Text="设备"
                                       VerticalAlignment="Center" />
                            <Button x:Name="ScanButton"
                                    HorizontalAlignment="Right"
                                    Content="扫描设备"
                                    Style="{StaticResource SmallSubtleButtonStyle}"
                                    Click="ScanButton_Click" />
                        </Grid>

                        <ListBox x:Name="PeerList"
                                 MinHeight="60"
                                 MaxHeight="168"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemContainerStyle="{StaticResource PeerListItemStyle}"
                                 Foreground="{DynamicResource TextBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 SelectionChanged="PeerList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28"
                                                Height="28"
                                                Background="{DynamicResource IconBackgroundBrush}"
                                                CornerRadius="5">
                                            <Path Data="{StaticResource DeviceIconGeometry}"
                                                  Style="{StaticResource SmallGlyphPath}"
                                                  Stroke="{DynamicResource IconStrokeBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1"
                                                    Margin="9,0,6,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding DetailText}" />
                                            <TextBlock Margin="0,2,0,0"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       Text="{Binding LastConnectedText}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="2"
                                                Padding="5,1"
                                                VerticalAlignment="Center"
                                                CornerRadius="999">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsKnown}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsKnownOnly}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="9.5"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        <Setter Property="Text" Value="最近" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsKnownOnly}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                                                <Setter Property="Text" Value="未发现" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ConnectButton"
                                    Content="连接选中设备"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="ConnectButton_Click" />
                            <Button x:Name="QuickReconnectButton"
                                    Grid.Column="2"
                                    Content="快速重连"
                                    Click="QuickReconnectButton_Click" />
                        </Grid>

                        <Button x:Name="WaitButton"
                                Margin="0,8,0,0"
                                Content="等待连接"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="WaitButton_Click" />

                        <Border Height="1"
                                Margin="0,16,0,12"
                                Background="{DynamicResource BorderBrush}" />

                        <TextBlock Style="{StaticResource SectionTitleText}"
                                   Text="文本" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="SendTextButton"
                                    Content="发送文本"
                                    ToolTip="向对端发送一段文本"
                                    Click="SendTextButton_Click" />
                            <Button x:Name="TextInboxButton"
                                    Grid.Column="2"
                                    Content="收到的文本"
                                    ToolTip="查看收到的文本"
                                    Click="TextInboxButton_Click" />
                        </Grid>

                        <Border Height="1"
                                Margin="0,16,0,10"
                                Background="{DynamicResource BorderBrush}" />

                        <ToggleButton x:Name="AdvancedSettingsToggle"
                                      AutomationProperties.Name="更多设置"
                                      AutomationProperties.HelpText="展开剪贴板、远程文本和接收目录设置"
                                      Style="{StaticResource AdvancedToggleStyle}"
                                      Checked="AdvancedSettingsToggle_Changed"
                                      Unchecked="AdvancedSettingsToggle_Changed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           Text="更多设置" />
                                <TextBlock x:Name="AdvancedSettingsChevron"
                                           Grid.Column="2"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           Text="⌄" />
                            </Grid>
                        </ToggleButton>

                        <StackPanel x:Name="AdvancedSettingsPanel"
                                    Margin="4,4,4,0"
                                    Visibility="Collapsed">
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource MetaText}"
                                       Text="主题" />
                            <ComboBox x:Name="ThemeModeComboBox"
                                      Margin="0,4,0,0"
                                      SelectedIndex="0"
                                      Style="{StaticResource CompactComboBoxStyle}"
                                      SelectionChanged="ThemeModeComboBox_SelectionChanged">
                                <ComboBoxItem Content="跟随系统"
                                              Tag="System" />
                                <ComboBoxItem Content="浅色"
                                              Tag="Light" />
                                <ComboBoxItem Content="深色"
                                              Tag="Dark" />
                            </ComboBox>
                            <TextBlock Margin="24,3,0,0"
                                       Style="{StaticResource TinyText}"
                                       Text="深色模式会立即应用到所有窗口。"
                                       TextWrapping="Wrap" />

                            <CheckBox x:Name="ExplorerContextMenuCheckBox"
                                      Margin="0,10,0,0"
                                      Content="资源管理器右键发送"
                                      ToolTip="在资源管理器中右键文件或文件夹，选择“通过 Wi-Fi Direct 发送”"
                                      Style="{StaticResource WdtCheckBoxStyle}"
                                      Checked="ExplorerContextMenuCheckBox_Checked"
                                      Unchecked="ExplorerContextMenuCheckBox_Unchecked" />
                            <TextBlock Margin="24,3,0,0"
                                       Style="{StaticResource TinyText}"
                                       Text="只注册当前用户。右键文件或文件夹后可直接加入发送队列；多选时请逐个发送。"
                                       TextWrapping="Wrap" />

                            <CheckBox x:Name="ClipboardSyncCheckBox"
                                      Margin="0,6,0,0"
                                      Content="启用剪贴板同步"
                                      Style="{StaticResource WdtCheckBoxStyle}"
                                      Checked="ClipboardSyncCheckBox_Checked"
                                      Unchecked="ClipboardSyncCheckBox_Unchecked" />
                            <TextBlock Margin="24,3,0,0"
                                       Style="{StaticResource TinyText}"
                                       Text="对端可看到你复制的内容。大图片可能不会出现在 Win+V 历史里，直接粘贴正常。"
                                       TextWrapping="Wrap" />

                            <CheckBox x:Name="TextReceiveCheckBox"
                                      Margin="0,10,0,0"
                                      Content="允许接收远程文本"
                                      Style="{StaticResource WdtCheckBoxStyle}"
                                      Checked="TextReceiveCheckBox_Checked"
                                      Unchecked="TextReceiveCheckBox_Unchecked" />
                            <TextBlock Margin="24,3,0,0"
                                       Style="{StaticResource TinyText}"
                                       Text="对端发送的文本会显示在文本收件箱中，默认关闭。"
                                       TextWrapping="Wrap" />

                            <CheckBox x:Name="NotificationsCheckBox"
                                      Margin="0,10,0,0"
                                      Content="启用系统通知"
                                      Style="{StaticResource WdtCheckBoxStyle}"
                                      Checked="NotificationsCheckBox_Checked"
                                      Unchecked="NotificationsCheckBox_Unchecked" />
                            <TextBlock Margin="24,3,0,0"
                                       Style="{StaticResource TinyText}"
                                       Text="连接请求、传输完成和自动重连结果会显示托盘通知。"
                                       TextWrapping="Wrap" />

                            <StackPanel x:Name="SameNamePolicyPanel"
                                        Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource MetaText}"
                                           Text="同名文件" />
                                <ComboBox x:Name="SameNamePolicyComboBox"
                                          Margin="0,4,0,0"
                                          SelectedIndex="0"
                                          Style="{StaticResource CompactComboBoxStyle}"
                                          SelectionChanged="SameNamePolicyComboBox_SelectionChanged">
                                    <ComboBoxItem Content="自动重命名（追加 (1)、(2)）"
                                                  Tag="AutoRename" />
                                    <ComboBoxItem Content="覆盖"
                                                  Tag="Overwrite" />
                                    <ComboBoxItem Content="跳过"
                                                  Tag="Skip" />
                                </ComboBox>
                            </StackPanel>

                            <TextBlock Margin="0,12,0,0"
                                       Style="{StaticResource MetaText}"
                                       Text="接收目录" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ReceiveDirectoryText"
                                           VerticalAlignment="Center"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                <Button x:Name="ChangeReceiveDirectoryButton"
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Content="更改…"
                                        Style="{StaticResource SmallSubtleButtonStyle}"
                                        Click="ChangeReceiveDirectoryButton_Click" />
                            </Grid>

                            <Button x:Name="SendTestFileButton"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Left"
                                    Content="发送测试文件（1 MiB）"
                                    Style="{StaticResource SmallSubtleButtonStyle}"
                                    Click="SendTestFileButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右侧：传输工作区 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                    <RowDefinition x:Name="LogRow"
                                   Height="160"
                                   MinHeight="120" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="16,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="SendTabButton"
                                         Content="发送"
                                         GroupName="TransferTabs"
                                         IsChecked="True"
                                         Style="{StaticResource TransferTabStyle}"
                                         Checked="TransferTab_Checked" />
                            <RadioButton x:Name="ReceiveTabButton"
                                         Content="接收"
                                         GroupName="TransferTabs"
                                         Style="{StaticResource TransferTabStyle}"
                                         Checked="TransferTab_Checked" />
                        </StackPanel>
                        <TextBlock x:Name="WorkspaceHintText"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Text="拖入文件即可加入发送队列" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="16,12,16,0">
                    <!-- 发送 -->
                    <Grid x:Name="SendPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SectionTitleText}"
                                           Text="传输队列"
                                           VerticalAlignment="Center" />
                                <TextBlock Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding EmptyDirectorySummary}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource TinyText}">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowEmptyDirectorySummary}"
                                                             Value="True">
                                                    <Setter Property="Visibility"
                                                            Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button x:Name="AddQueueFilesButton"
                                        Content="添加文件…"
                                        Style="{StaticResource SmallButtonStyle}"
                                        Click="AddQueueFilesButton_Click" />
                                <Button x:Name="AddQueueFolderButton"
                                        Margin="6,0,0,0"
                                        Content="添加文件夹…"
                                        Style="{StaticResource SmallButtonStyle}"
                                        Click="AddQueueFolderButton_Click" />
                                <Button x:Name="StartQueueButton"
                                        Margin="6,0,0,0"
                                        Content="开始传输"
                                        Style="{StaticResource SmallPrimaryButtonStyle}"
                                        Click="StartQueueButton_Click" />
                                <Button x:Name="PauseQueueButton"
                                        Margin="6,0,0,0"
                                        Content="暂停"
                                        Style="{StaticResource SmallSubtleButtonStyle}"
                                        Click="PauseQueueButton_Click" />
                                <Button x:Name="ClearQueueButton"
                                        Margin="4,0,0,0"
                                        Content="清空"
                                        Style="{StaticResource SmallSubtleButtonStyle}"
                                        Click="ClearQueueButton_Click" />
                                <Button x:Name="QueueDetailsToggleButton"
                                        Margin="2,0,0,0"
                                        Content="详情"
                                        Style="{StaticResource SmallSubtleButtonStyle}"
                                        ToolTip="展开或收起当前传输详情"
                                        Click="QueueDetailsToggleButton_Click" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                Margin="0,0,0,10"
                                Padding="12"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentPositionText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="11.5" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentFile, FallbackValue={x:Null}}"
                                                                     Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Margin="6,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Text="·">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentFile, FallbackValue={x:Null}}"
                                                                     Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock MaxWidth="420"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="{Binding CurrentFile.DisplayPath, TargetNullValue=尚未开始, FallbackValue=尚未开始}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding CurrentFile.SourcePath}" />
                                    </StackPanel>
                                    <TextBlock HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource CurrentStatusTextStyle}"
                                               Text="{Binding CurrentFile.StatusText, TargetNullValue=等待添加文件, FallbackValue=等待添加文件}" />
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentFile, FallbackValue={x:Null}}"
                                                             Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Style="{StaticResource TinyText}"
                                                       Text="当前文件" />
                                            <TextBlock HorizontalAlignment="Right"
                                                       Style="{StaticResource TinyText}"
                                                       Text="{Binding CurrentFile.ProgressPercent, StringFormat={}{0:0}%}" />
                                        </Grid>
                                        <ProgressBar Height="6"
                                                     Margin="0,4,0,0"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding CurrentFile.ProgressPercent, Mode=OneWay, FallbackValue=0}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Style="{StaticResource TinyText}"
                                                   Text="{Binding CurrentFile.TransferRateText, TargetNullValue=—, FallbackValue=—}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Grid>
                                            <TextBlock Style="{StaticResource TinyText}"
                                                       Text="总体进度" />
                                            <TextBlock HorizontalAlignment="Right"
                                                       Style="{StaticResource TinyText}"
                                                       Text="{Binding OverallProgressText}" />
                                        </Grid>
                                        <ProgressBar Height="6"
                                                     Margin="0,4,0,0"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding OverallProgressPercent, Mode=OneWay}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Style="{StaticResource TinyText}"
                                                   Text="{Binding OverallTransferText, TargetNullValue=—, FallbackValue=—}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="31" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0"
                                          Background="{DynamicResource SurfaceAltBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="1" Margin="12,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="116" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center"
                                                       Style="{StaticResource TinyText}"
                                                       Text="文件" />
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource TinyText}"
                                                       Text="大小" />
                                            <TextBlock Grid.Column="2"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource TinyText}"
                                                       Text="状态" />
                                            <TextBlock Grid.Column="3"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource TinyText}"
                                                       Text="进度" />
                                        </Grid>
                                    </Grid>

                                    <Grid Grid.Row="1">
                                        <ListBox x:Name="QueueList"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 ItemContainerStyle="{StaticResource QueueListItemStyle}"
                                                 ItemsSource="{Binding Files}"
                                                 SelectionChanged="QueueList_SelectionChanged"
                                                 PreviewMouseRightButtonDown="QueueList_PreviewMouseRightButtonDown"
                                                 ContextMenuOpening="QueueList_ContextMenuOpening"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem x:Name="ViewQueueItemDetailsMenuItem"
                                                              Header="查看详情"
                                                              Click="ViewQueueItemDetailsMenuItem_Click" />
                                                    <Separator />
                                                    <MenuItem x:Name="MoveQueueUpMenuItem"
                                                              Header="上移"
                                                              Click="MoveQueueUpMenuItem_Click" />
                                                    <MenuItem x:Name="MoveQueueDownMenuItem"
                                                              Header="下移"
                                                              Click="MoveQueueDownMenuItem_Click" />
                                                    <MenuItem x:Name="RemoveQueueItemMenuItem"
                                                              Header="从队列移除"
                                                              Click="RemoveQueueItemMenuItem_Click" />
                                                </ContextMenu>
                                            </ListBox.ContextMenu>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource RowSeparatorBrush}"
                                                            BorderThickness="0,0,0,1">
                                                        <Grid Height="48" Margin="12,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="64" />
                                                                <ColumnDefinition Width="72" />
                                                                <ColumnDefinition Width="116" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid VerticalAlignment="Center">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="24"
                                                                        Height="24"
                                                                        Background="{DynamicResource IconBackgroundBrush}"
                                                                        CornerRadius="4">
                                                                    <Path Data="{StaticResource FileIconGeometry}"
                                                                          Style="{StaticResource SmallGlyphPath}"
                                                                          Stroke="{DynamicResource IconStrokeBrush}" />
                                                                </Border>
                                                                <StackPanel Grid.Column="1"
                                                                            Margin="8,0,0,0"
                                                                            VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding DisplayPath}"
                                                                               FontSize="12"
                                                                               FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               ToolTip="{Binding SourcePath}" />
                                                                    <TextBlock Margin="0,2,0,0"
                                                                               FontSize="10"
                                                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                                                               Text="{Binding SourcePath}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </Grid>
                                                            <TextBlock Grid.Column="1"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="10.5"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       Text="{Binding Size, Converter={StaticResource ByteSizeConverter}}" />
                                                            <TextBlock Grid.Column="2"
                                                                       VerticalAlignment="Center"
                                                                       Style="{StaticResource QueueStatusTextStyle}"
                                                                       Text="{Binding StatusText}" />
                                                            <Grid Grid.Column="3" VerticalAlignment="Center">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <ProgressBar Height="4"
                                                                             VerticalAlignment="Center"
                                                                             Maximum="100"
                                                                             Minimum="0"
                                                                             Style="{StaticResource QueueProgressBarStyle}"
                                                                             Value="{Binding ProgressPercent, Mode=OneWay}" />
                                                                <TextBlock Grid.Column="1"
                                                                           Width="34"
                                                                           Margin="8,0,0,0"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="10"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           Text="{Binding ProgressText}"
                                                                           TextAlignment="Right" />
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                    </Grid>

                                    <Grid x:Name="QueueEmptyPanel"
                                          Grid.RowSpan="2"
                                          Background="{DynamicResource SurfaceBrush}">
                                        <StackPanel Width="360"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <Border Width="44"
                                                    Height="44"
                                                    HorizontalAlignment="Center"
                                                    Background="{DynamicResource AccentSoftBrush}"
                                                    CornerRadius="10">
                                                <Path Width="22"
                                                      Height="22"
                                                      Data="{StaticResource FolderIconGeometry}"
                                                      Fill="Transparent"
                                                      Stretch="Uniform"
                                                      Stroke="{DynamicResource AccentBrush}"
                                                      StrokeThickness="1.3" />
                                            </Border>
                                            <TextBlock x:Name="QueueEmptyText"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,12,0,0"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Text="队列为空" />
                                            <TextBlock x:Name="QueueEmptyHintText"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,6,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       Text="拖入文件或文件夹，或从资源管理器添加"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap" />
                                            <Button Margin="0,14,0,0"
                                                    HorizontalAlignment="Center"
                                                    Content="添加文件…"
                                                    IsEnabled="{Binding IsEnabled, ElementName=AddQueueFilesButton}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="AddQueueFilesButton_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border x:Name="QueueDetailsPanel"
                                    Grid.Column="1"
                                    Width="240"
                                    Margin="12,0,0,0"
                                    Padding="12"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Visibility="Collapsed">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Style="{StaticResource SectionTitleText}"
                                                       Text="文件详情" />
                                            <TextBlock HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource CurrentStatusTextStyle}"
                                                       Text="{Binding DetailsFile.StatusText, TargetNullValue=未选择, FallbackValue=未选择}" />
                                        </Grid>
                                        <TextBlock Margin="0,10,0,0"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding DetailsFile.DisplayPath, TargetNullValue=未选择, FallbackValue=未选择}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Style="{StaticResource TinyText}"
                                                   Text="{Binding DetailsFile.SourcePath, TargetNullValue=选择队列中的文件或开始传输后显示完整路径, FallbackValue=选择队列中的文件或开始传输后显示完整路径}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,10,0,0"
                                                   Text="选择队列中的文件，或开始传输后查看详情。">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TinyText}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DetailsFile, FallbackValue={x:Null}}"
                                                                     Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <StackPanel x:Name="QueueDetailsFields">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DetailsFile, FallbackValue={x:Null}}"
                                                                     Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <ProgressBar Height="6"
                                                         Margin="0,10,0,0"
                                                         Maximum="100"
                                                         Minimum="0"
                                                         Value="{Binding DetailsFile.ProgressPercent, Mode=OneWay, FallbackValue=0}" />

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Style="{StaticResource TinyText}" Text="大小" />
                                            <TextBlock Grid.Column="1"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding DetailsFile.Size, Converter={StaticResource ByteSizeConverter}, TargetNullValue=—}" />
                                            <TextBlock Grid.Row="1"
                                                       Margin="0,7,0,0"
                                                       Style="{StaticResource TinyText}"
                                                       Text="已发送" />
                                            <TextBlock Grid.Row="1"
                                                       Grid.Column="1"
                                                       Margin="0,7,0,0"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding DetailsFile.BytesTransferred, Converter={StaticResource ByteSizeConverter}, TargetNullValue=—}" />
                                            <TextBlock Grid.Row="2"
                                                       Margin="0,7,0,0"
                                                       Style="{StaticResource TinyText}"
                                                       Text="速率" />
                                            <TextBlock Grid.Row="2"
                                                       Grid.Column="1"
                                                       Margin="0,7,0,0"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding DetailsFile.SpeedText, TargetNullValue=—}" />
                                            <TextBlock Grid.Row="3"
                                                       Margin="0,7,0,0"
                                                       Style="{StaticResource TinyText}"
                                                       Text="预计剩余" />
                                            <TextBlock Grid.Row="3"
                                                       Grid.Column="1"
                                                       Margin="0,7,0,0"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding DetailsFile.EtaText, TargetNullValue=—}" />
                                            <TextBlock Grid.Row="4"
                                                       Margin="0,7,0,0"
                                                       Style="{StaticResource TinyText}"
                                                       Text="续传偏移" />
                                            <TextBlock Grid.Row="4"
                                                       Grid.Column="1"
                                                       Margin="0,7,0,0"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding DetailsFile.StartOffset, Converter={StaticResource ByteSizeConverter}, TargetNullValue=—}" />
                                            <TextBlock Grid.Row="5"
                                                       Margin="0,7,0,0"
                                                       Style="{StaticResource TinyText}"
                                                       Text="队列位置" />
                                            <TextBlock Grid.Row="5"
                                                       Grid.Column="1"
                                                       Margin="0,7,0,0"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding DetailsPositionText, TargetNullValue=—}" />
                                        </Grid>
                                        </StackPanel>

                                        <TextBlock Margin="0,10,0,0"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   Text="{Binding DetailsFile.ErrorMessage}"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DetailsFile.ErrorMessage}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- 接收 -->
                    <Grid x:Name="ReceivePanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border x:Name="CurrentReceivePanel"
                                Margin="0,0,0,10"
                                Padding="12"
                                Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource AccentLineBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6"
                                             Height="6"
                                             Margin="0,0,6,0"
                                             VerticalAlignment="Center"
                                             Fill="{DynamicResource AccentBrush}" />
                                    <TextBlock FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Text="正在接收" />
                                </StackPanel>
                                <TextBlock Grid.Row="1"
                                           Margin="0,4,0,0"
                                           Text="{Binding DisplayPath}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="2"
                                           Margin="0,4,0,0"
                                           Text="{Binding DetailText}"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <ProgressBar Grid.Row="3"
                                             Height="6"
                                             Margin="0,7,0,0"
                                             Maximum="100"
                                             Minimum="0"
                                             Value="{Binding ProgressPercent, Mode=OneWay}" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource SectionTitleText}"
                                           Text="本次已接收文件"
                                           VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <TextBlock Margin="0,0,8,0"
                                               VerticalAlignment="Center"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Text="可拖出到资源管理器" />
                                    <Button x:Name="OpenReceivedFolderButton"
                                            Content="打开所在文件夹"
                                            IsEnabled="False"
                                            Style="{StaticResource SmallButtonStyle}"
                                            Click="OpenReceivedFolderButton_Click" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid>
                                    <ListBox x:Name="ReceivedFilesList"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ItemContainerStyle="{StaticResource ReceivedListItemStyle}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             SelectionMode="Extended"
                                             SelectionChanged="ReceivedFilesList_SelectionChanged"
                                             PreviewMouseLeftButtonDown="ReceivedFilesList_PreviewMouseLeftButtonDown"
                                             PreviewMouseLeftButtonUp="ReceivedFilesList_PreviewMouseLeftButtonUp"
                                             MouseMove="ReceivedFilesList_MouseMove"
                                             MouseDoubleClick="ReceivedFilesList_MouseDoubleClick">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource RowSeparatorBrush}"
                                                        BorderThickness="0,0,0,1">
                                                    <Grid Height="50" Margin="12,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="26"
                                                                Height="26"
                                                                VerticalAlignment="Center"
                                                                Background="{DynamicResource IconBackgroundBrush}"
                                                                CornerRadius="4">
                                                            <Path Data="{StaticResource FileIconGeometry}"
                                                                  Style="{StaticResource SmallGlyphPath}"
                                                                  Stroke="{DynamicResource IconStrokeBrush}" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1"
                                                                    Margin="9,0,0,0"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayPath}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding FilePath}" />
                                                            <TextBlock Margin="0,2,0,0"
                                                                       FontSize="10"
                                                                       Text="{Binding DetailText}"
                                                                       TextTrimming="CharacterEllipsis">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <StackPanel x:Name="ReceivedFilesEmptyPanel"
                                                Width="340"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsHitTestVisible="False">
                                        <Border Width="40"
                                                Height="40"
                                                HorizontalAlignment="Center"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                CornerRadius="10">
                                            <Path Width="20"
                                                  Height="20"
                                                  Data="{StaticResource FolderIconGeometry}"
                                                  Fill="Transparent"
                                                  Stretch="Uniform"
                                                  Stroke="{DynamicResource AccentBrush}"
                                                  StrokeThickness="1.3" />
                                        </Border>
                                        <TextBlock x:Name="ReceivedFilesEmptyText"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,10,0,0"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Text="暂无接收文件" />
                                        <TextBlock HorizontalAlignment="Center"
                                                   Margin="0,5,0,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Text="接收完成后会显示在这里，可直接拖到资源管理器"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <Border x:Name="LogPanel"
                        Grid.Row="2"
                        Margin="16,10,16,10"
                        Padding="12"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource SectionTitleText}"
                                       Text="日志"
                                       VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button x:Name="HistoryButton"
                                        Content="传输历史"
                                        Style="{StaticResource SmallSubtleButtonStyle}"
                                        ToolTip="查看传输历史"
                                        Click="HistoryButton_Click" />
                                <Button x:Name="ExportDiagnosticsButton"
                                        Margin="2,0,0,0"
                                        Content="诊断"
                                        Style="{StaticResource SmallSubtleButtonStyle}"
                                        ToolTip="导出日志、设置和构建信息"
                                        Click="ExportDiagnosticsButton_Click" />
                                <Button x:Name="AboutButton"
                                        Margin="2,0,0,0"
                                        Content="关于"
                                        Style="{StaticResource SmallSubtleButtonStyle}"
                                        Click="AboutButton_Click" />
                                <Button x:Name="ClearLogButton"
                                        Margin="2,0,0,0"
                                        Content="清空"
                                        Style="{StaticResource SmallSubtleButtonStyle}"
                                        ToolTip="清空界面日志"
                                        Click="ClearLogButton_Click" />
                                <Button x:Name="LogToggleButton"
                                        Margin="4,0,0,0"
                                        Content="折叠"
                                        Style="{StaticResource SmallSubtleButtonStyle}"
                                        ToolTip="折叠或展开日志"
                                        Click="LogToggleButton_Click" />
                            </StackPanel>
                        </Grid>

                        <TextBox x:Name="LogTextBox"
                                 Grid.Row="1"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 Style="{StaticResource LogTextBoxStyle}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2"
                Background="{DynamicResource StatusBarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Text="未连接"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ProtocolVersionText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="10.5"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Text="双向传输" />
            </Grid>
        </Border>
    </Grid>
</Window>
