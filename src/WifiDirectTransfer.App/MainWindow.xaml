<Window x:Class="WifiDirectTransfer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Wi-Fi Direct 文件传输"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1120"
        Height="760"
        MinWidth="1000"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDrop="Window_PreviewDrop"
        Loaded="OnLoaded"
        Closing="OnClosing"
        StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}" />

        <Geometry x:Key="FileIconGeometry">M4,1.8 H9.5 L13,5.3 V14.2 H4 Z M9.5,1.8 V5.3 H13</Geometry>
        <Geometry x:Key="DeviceIconGeometry">M2.5,3.5 H13.5 V11 H2.5 Z M1.5,13.5 H14.5</Geometry>
        <Geometry x:Key="FolderIconGeometry">M1.8,4.2 H6.2 L7.6,6.1 H14.2 V12.8 H1.8 Z</Geometry>
        <Geometry x:Key="WifiLogoGeometry">M2.4,8.2 A13,13 0 0 1 21.6,8.2 M6.2,12 A8,8 0 0 1 17.8,12 M9.8,15.7 A3.4,3.4 0 0 1 14.2,15.7 M11.4,19.2 A1,1 0 0 1 12.6,19.2</Geometry>
        <Geometry x:Key="WaitIconGeometry">M12,3.2 A8.8,8.8 0 1 1 3.2,12 M12,7.2 V12 L15.4,14 M3.2,12 H7.4 M3.2,12 V7.8</Geometry>
        <Geometry x:Key="ShieldIconGeometry">M12,3 L19,6 V11.5 C19,15.8 16,18.8 12,20.4 C8,18.8 5,15.8 5,11.5 V6 Z M9.2,11.8 L11.2,13.8 L15,9.8</Geometry>
        <Geometry x:Key="ResumeIconGeometry">M4,12 A8,8 0 1 1 6.3,17.6 M4,17 V12 H9</Geometry>
        <Geometry x:Key="CheckIconGeometry">M4,12.4 L9.6,18 L20,6.4</Geometry>
        <Geometry x:Key="SearchGlyph">M10.8,3.6 A7.2,7.2 0 1 1 3.6,10.8 A7.2,7.2 0 0 1 10.8,3.6 M16,16 L20.4,20.4</Geometry>
        <Geometry x:Key="SendUpGlyph">M12,20 V4 M5.6,10.4 L12,4 L18.4,10.4</Geometry>
        <Geometry x:Key="FolderAddGlyph">M3.5,7.5 A1.5,1.5 0 0 1 5,6 H9 L11,8.5 H19 A1.5,1.5 0 0 1 20.5,10 V17 A1.5,1.5 0 0 1 19,18.5 H5 A1.5,1.5 0 0 1 3.5,17 Z M12,11.4 V15.6 M9.9,13.5 H14.1</Geometry>
        <Geometry x:Key="MinimizeGlyph">M2,7 H12</Geometry>
        <Geometry x:Key="MaximizeGlyph">M2.5,2.5 H11.5 V11.5 H2.5 Z</Geometry>
        <Geometry x:Key="RestoreGlyph">M4.5,2.5 H11.5 V9.5 H4.5 Z M2.5,4.5 V11.5 H9.5</Geometry>
        <Geometry x:Key="CloseGlyph">M2.8,2.8 L11.2,11.2 M11.2,2.8 L2.8,11.2</Geometry>
        <Geometry x:Key="ChevronDownGlyph">M3,5 L7,9 L11,5</Geometry>
        <Geometry x:Key="PauseGlyph">M5.2,3.5 V12.5 M10.8,3.5 V12.5</Geometry>
        <Geometry x:Key="MoreGlyph">M2.2,8 A1.3,1.3 0 1 1 4.8,8 A1.3,1.3 0 1 1 2.2,8 M6.7,8 A1.3,1.3 0 1 1 9.3,8 A1.3,1.3 0 1 1 6.7,8 M11.2,8 A1.3,1.3 0 1 1 13.8,8 A1.3,1.3 0 1 1 11.2,8</Geometry>

        <Style x:Key="SmallGlyphPath" TargetType="Path">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="StrokeThickness" Value="1.2" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
        </Style>

        <Style x:Key="TitleBarGlyphStyle" TargetType="Path">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke"
                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="StrokeThickness" Value="1.1" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
        </Style>

        <Style x:Key="QueueStatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Transferring">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Skipped">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QueueProgressBarStyle"
               TargetType="ProgressBar"
               BasedOn="{StaticResource {x:Type ProgressBar}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Skipped">
                    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CurrentStatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentFile.Status}" Value="Transferring">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentFile.Status}" Value="Completed">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentFile.Status}" Value="Failed">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="RootFrame"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="68" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- 自定义标题栏 -->
            <Grid Grid.Row="0" Background="{DynamicResource SurfaceBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="18,0,0,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="26"
                            Height="26"
                            Background="{DynamicResource AccentGradientBrush}"
                            CornerRadius="8">
                        <Path Width="16"
                              Height="16"
                              Data="{StaticResource WifiLogoGeometry}"
                              Stretch="Uniform"
                              Stroke="White"
                              StrokeEndLineCap="Round"
                              StrokeStartLineCap="Round"
                              StrokeThickness="1.7" />
                    </Border>
                    <TextBlock Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Text="Wi-Fi Direct 文件传输" />
                    <Border Margin="8,0,0,0"
                            Padding="7,2"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SegmentBackgroundBrush}"
                            CornerRadius="6">
                        <TextBlock x:Name="TitleBarVersionText"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Text="v1.6.3" />
                    </Border>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Text="点对点直连 · 不经过云端" />

                <StackPanel Grid.Column="2"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton"
                            AutomationProperties.Name="最小化"
                            Style="{StaticResource TitleBarButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MinimizeButton_Click">
                        <Path Data="{StaticResource MinimizeGlyph}"
                              Style="{StaticResource TitleBarGlyphStyle}" />
                    </Button>
                    <Button x:Name="MaximizeButton"
                            AutomationProperties.Name="最大化"
                            Style="{StaticResource TitleBarButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MaximizeButton_Click">
                        <Grid Width="12" Height="12">
                            <Path x:Name="MaximizeGlyph"
                                  Data="{StaticResource MaximizeGlyph}"
                                  Style="{StaticResource TitleBarGlyphStyle}" />
                            <Path x:Name="RestoreGlyph"
                                  Data="{StaticResource RestoreGlyph}"
                                  Style="{StaticResource TitleBarGlyphStyle}"
                                  Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button x:Name="CloseButton"
                            AutomationProperties.Name="关闭"
                            Style="{StaticResource CloseTitleBarButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click">
                        <Path Data="{StaticResource CloseGlyph}"
                              Style="{StaticResource TitleBarGlyphStyle}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 命令栏：连接状态 + 能力状态 -->
            <Border Grid.Row="1"
                    Background="Transparent"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border x:Name="ConnectionChip"
                                Padding="12,5"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="18">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ConnectionDot"
                                         Width="8"
                                         Height="8"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock x:Name="ConnectionStatusText"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="未连接" />
                                <Border Width="1"
                                        Height="13"
                                        Margin="9,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource BorderBrush}" />
                                <TextBlock x:Name="ConnectionPeerText"
                                           MaxWidth="220"
                                           VerticalAlignment="Center"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="选择设备并连接"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="DisconnectButton"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="断开连接"
                                Content="断开"
                                Style="{StaticResource SmallButtonStyle}"
                                ToolTip="断开当前连接"
                                Visibility="Collapsed"
                                Click="DisconnectButton_Click" />
                    </StackPanel>

                    <TextBlock x:Name="ConnectionHintText"
                               Grid.Column="1"
                               Margin="18,0"
                               VerticalAlignment="Center"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Text="连接后双方都可以发送和接收文件"
                               TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Ellipse x:Name="CapabilityDot"
                                 Width="8"
                                 Height="8"
                                 VerticalAlignment="Center"
                                 Fill="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock x:Name="CapabilityText"
                                   MaxWidth="360"
                                   Margin="7,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="正在检查 Wi-Fi Direct 能力…"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </StackPanel>
                </Grid>
            </Border>

        <Grid x:Name="MainContentGrid"
              Grid.Row="2"
              Margin="20,16,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="296" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：连接与设备 -->
            <Border x:Name="LeftRailCard"
                    Grid.Column="0"
                    Margin="0,0,18,0"
                    Style="{StaticResource CardBorderStyle}">
                <ScrollViewer x:Name="LeftRailScrollViewer"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,18,16,18">
                        <TextBlock Style="{StaticResource SectionLabelText}"
                                   Text="连接方式" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="RoleReceiverRadio"
                                         GroupName="Role"
                                         Style="{StaticResource SegmentRadioStyle}"
                                         Checked="RoleRadio_Checked">
                                <StackPanel>
                                    <Path Width="18"
                                          Height="18"
                                          HorizontalAlignment="Left"
                                          Data="{StaticResource WaitIconGeometry}"
                                          Fill="Transparent"
                                          Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="1.5" />
                                    <TextBlock Margin="0,8,0,0"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               Text="等待连接" />
                                    <TextBlock Margin="0,2,0,0"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Text="让对端发现本机"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RoleSenderRadio"
                                         Grid.Column="2"
                                         GroupName="Role"
                                         Style="{StaticResource SegmentRadioStyle}"
                                         Checked="RoleRadio_Checked">
                                <StackPanel>
                                    <Path Width="18"
                                          Height="18"
                                          HorizontalAlignment="Left"
                                          Data="{StaticResource DeviceIconGeometry}"
                                          Fill="Transparent"
                                          Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="1.5" />
                                    <TextBlock Margin="0,8,0,0"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               Text="连接设备" />
                                    <TextBlock Margin="0,2,0,0"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Text="主动扫描对端"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                        </Grid>
                        <Grid Margin="0,14,0,8">
                            <TextBlock Style="{StaticResource SectionTitleText}"
                                       Text="设备"
                                       VerticalAlignment="Center" />
                            <Button x:Name="ScanButton"
                                    HorizontalAlignment="Right"
                                    Content="扫描设备"
                                    Style="{StaticResource SmallSubtleButtonStyle}"
                                    Click="ScanButton_Click" />
                        </Grid>

                        <ListBox x:Name="PeerList"
                                 MinHeight="60"
                                 MaxHeight="168"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemContainerStyle="{StaticResource PeerListItemStyle}"
                                 Foreground="{DynamicResource TextBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 SelectionChanged="PeerList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28"
                                                Height="28"
                                                Background="{DynamicResource IconBackgroundBrush}"
                                                CornerRadius="8">
                                            <Path Data="{StaticResource DeviceIconGeometry}"
                                                  Style="{StaticResource SmallGlyphPath}"
                                                  Stroke="{DynamicResource IconStrokeBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1"
                                                    Margin="9,0,6,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding DetailText}" />
                                            <TextBlock Margin="0,2,0,0"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       Text="{Binding LastConnectedText}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="2"
                                                Padding="5,1"
                                                VerticalAlignment="Center"
                                                CornerRadius="999">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsKnown}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsKnownOnly}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="9.5"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        <Setter Property="Text" Value="最近" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsKnownOnly}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                                                <Setter Property="Text" Value="未发现" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ConnectButton"
                                    Content="连接选中设备"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="ConnectButton_Click" />
                            <Button x:Name="QuickReconnectButton"
                                    Grid.Column="2"
                                    Content="快速重连"
                                    Click="QuickReconnectButton_Click" />
                        </Grid>

                        <Button x:Name="WaitButton"
                                Margin="0,8,0,0"
                                Content="等待连接"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="WaitButton_Click" />

                        <Border Height="1"
                                Margin="0,16,0,12"
                                Background="{DynamicResource BorderBrush}" />

                        <TextBlock Style="{StaticResource SectionTitleText}"
                                   Text="文本" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="SendTextButton"
                                    Content="发送文本"
                                    ToolTip="向对端发送一段文本"
                                    Click="SendTextButton_Click" />
                            <Button x:Name="TextInboxButton"
                                    Grid.Column="2"
                                    Content="收到的文本"
                                    ToolTip="查看收到的文本"
                                    Click="TextInboxButton_Click" />
                        </Grid>

                        <Border Height="1"
                                Margin="0,16,0,10"
                                Background="{DynamicResource BorderBrush}" />

                        <ToggleButton x:Name="AdvancedSettingsToggle"
                                      AutomationProperties.Name="更多设置"
                                      AutomationProperties.HelpText="展开剪贴板、远程文本和接收目录设置"
                                      Style="{StaticResource AdvancedToggleStyle}"
                                      Checked="AdvancedSettingsToggle_Changed"
                                      Unchecked="AdvancedSettingsToggle_Changed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           Text="更多设置" />
                                <TextBlock x:Name="AdvancedSettingsChevron"
                                           Grid.Column="2"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           Text="⌄" />
                            </Grid>
                        </ToggleButton>

                        <StackPanel x:Name="AdvancedSettingsPanel"
                                    Margin="4,4,4,0"
                                    Visibility="Collapsed">
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource MetaText}"
                                       Text="主题" />
                            <ComboBox x:Name="ThemeModeComboBox"
                                      Margin="0,4,0,0"
                                      SelectedIndex="0"
                                      Style="{StaticResource CompactComboBoxStyle}"
                                      SelectionChanged="ThemeModeComboBox_SelectionChanged">
                                <ComboBoxItem Content="跟随系统"
                                              Tag="System" />
                                <ComboBoxItem Content="浅色"
                                              Tag="Light" />
                                <ComboBoxItem Content="深色"
                                              Tag="Dark" />
                            </ComboBox>
                            <TextBlock Margin="24,3,0,0"
                                       Style="{StaticResource TinyText}"
                                       Text="深色模式会立即应用到所有窗口。"
                                       TextWrapping="Wrap" />

                            <CheckBox x:Name="ExplorerContextMenuCheckBox"
                                      Margin="0,10,0,0"
                                      Content="资源管理器右键发送"
                                      ToolTip="在资源管理器中右键文件或文件夹，选择“通过 Wi-Fi Direct 发送”"
                                      Style="{StaticResource WdtCheckBoxStyle}"
                                      Checked="ExplorerContextMenuCheckBox_Checked"
                                      Unchecked="ExplorerContextMenuCheckBox_Unchecked" />
                            <TextBlock Margin="24,3,0,0"
                                       Style="{StaticResource TinyText}"
                                       Text="只注册当前用户。右键文件或文件夹后可直接加入发送队列；多选时请逐个发送。"
                                       TextWrapping="Wrap" />

                            <CheckBox x:Name="ClipboardSyncCheckBox"
                                      Margin="0,6,0,0"
                                      Content="启用剪贴板同步"
                                      Style="{StaticResource WdtCheckBoxStyle}"
                                      Checked="ClipboardSyncCheckBox_Checked"
                                      Unchecked="ClipboardSyncCheckBox_Unchecked" />
                            <TextBlock Margin="24,3,0,0"
                                       Style="{StaticResource TinyText}"
                                       Text="对端可看到你复制的内容。大图片可能不会出现在 Win+V 历史里，直接粘贴正常。"
                                       TextWrapping="Wrap" />

                            <CheckBox x:Name="TextReceiveCheckBox"
                                      Margin="0,10,0,0"
                                      Content="允许接收远程文本"
                                      Style="{StaticResource WdtCheckBoxStyle}"
                                      Checked="TextReceiveCheckBox_Checked"
                                      Unchecked="TextReceiveCheckBox_Unchecked" />
                            <TextBlock Margin="24,3,0,0"
                                       Style="{StaticResource TinyText}"
                                       Text="对端发送的文本会显示在文本收件箱中，默认关闭。"
                                       TextWrapping="Wrap" />

                            <CheckBox x:Name="NotificationsCheckBox"
                                      Margin="0,10,0,0"
                                      Content="启用系统通知"
                                      Style="{StaticResource WdtCheckBoxStyle}"
                                      Checked="NotificationsCheckBox_Checked"
                                      Unchecked="NotificationsCheckBox_Unchecked" />
                            <TextBlock Margin="24,3,0,0"
                                       Style="{StaticResource TinyText}"
                                       Text="连接请求、传输完成和自动重连结果会显示托盘通知。"
                                       TextWrapping="Wrap" />

                            <CheckBox x:Name="TrustedAutoAcceptCheckBox"
                                      Margin="0,10,0,0"
                                      Content="可信设备自动接受连接"
                                      Style="{StaticResource WdtCheckBoxStyle}"
                                      Checked="TrustedAutoAcceptCheckBox_Checked"
                                      Unchecked="TrustedAutoAcceptCheckBox_Unchecked" />
                            <TextBlock Margin="24,3,0,0"
                                       Style="{StaticResource TinyText}"
                                       Text="只对已配对且公钥指纹一致的设备生效；首次配对仍需确认配对码。"
                                       TextWrapping="Wrap" />
                            <Button x:Name="ManageTrustedDevicesButton"
                                    Margin="24,6,0,0"
                                    HorizontalAlignment="Left"
                                    Content="管理可信设备…"
                                    Style="{StaticResource SmallSubtleButtonStyle}"
                                    Click="ManageTrustedDevicesButton_Click" />

                            <CheckBox x:Name="AutoUpdateCheckBox"
                                      Margin="0,10,0,0"
                                      Content="启动时检查更新"
                                      Style="{StaticResource WdtCheckBoxStyle}"
                                      Checked="AutoUpdateCheckBox_Checked"
                                      Unchecked="AutoUpdateCheckBox_Unchecked" />
                            <TextBlock Margin="24,3,0,0"
                                       Style="{StaticResource TinyText}"
                                       Text="仅安装版可用；便携版请在“关于”中手动打开下载页。"
                                       TextWrapping="Wrap" />

                            <CheckBox x:Name="StartWithWindowsCheckBox"
                                      Margin="0,10,0,0"
                                      Content="开机自动启动"
                                      Style="{StaticResource WdtCheckBoxStyle}"
                                      Checked="StartWithWindowsCheckBox_Checked"
                                      Unchecked="StartWithWindowsCheckBox_Unchecked" />
                            <TextBlock Margin="24,3,0,0"
                                       Style="{StaticResource TinyText}"
                                       Text="登录后在托盘运行，不会自动开始等待连接；仅安装版可用。"
                                       TextWrapping="Wrap" />

                            <CheckBox x:Name="CloseToTrayCheckBox"
                                      Margin="0,10,0,0"
                                      Content="关闭窗口时最小化到托盘"
                                      Style="{StaticResource WdtCheckBoxStyle}"
                                      Checked="CloseToTrayCheckBox_Checked"
                                      Unchecked="CloseToTrayCheckBox_Unchecked" />
                            <TextBlock Margin="24,3,0,0"
                                       Style="{StaticResource TinyText}"
                                       Text="关闭后应用仍在托盘运行。双击图标恢复窗口，右键图标选择“退出”可完全退出。"
                                       TextWrapping="Wrap" />

                            <StackPanel x:Name="SameNamePolicyPanel"
                                        Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource MetaText}"
                                           Text="同名文件" />
                                <ComboBox x:Name="SameNamePolicyComboBox"
                                          Margin="0,4,0,0"
                                          SelectedIndex="0"
                                          Style="{StaticResource CompactComboBoxStyle}"
                                          SelectionChanged="SameNamePolicyComboBox_SelectionChanged">
                                    <ComboBoxItem Content="自动重命名（追加 (1)、(2)）"
                                                  Tag="AutoRename" />
                                    <ComboBoxItem Content="覆盖"
                                                  Tag="Overwrite" />
                                    <ComboBoxItem Content="跳过"
                                                  Tag="Skip" />
                                </ComboBox>
                            </StackPanel>

                            <TextBlock Margin="0,12,0,0"
                                       Style="{StaticResource MetaText}"
                                       Text="接收目录" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ReceiveDirectoryText"
                                           VerticalAlignment="Center"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                <Button x:Name="ChangeReceiveDirectoryButton"
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Content="更改…"
                                        Style="{StaticResource SmallSubtleButtonStyle}"
                                        Click="ChangeReceiveDirectoryButton_Click" />
                            </Grid>

                            <Button x:Name="SendTestFileButton"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Left"
                                    Content="发送测试文件（1 MiB）"
                                    Style="{StaticResource SmallSubtleButtonStyle}"
                                    Click="SendTestFileButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右侧：传输工作区 -->
            <Grid x:Name="WorkspaceGrid" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                    <RowDefinition x:Name="LogRow"
                                   Height="160"
                                   MinHeight="120" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Padding="4"
                            Background="{DynamicResource SegmentBackgroundBrush}"
                            CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="SendTabButton"
                                         Content="发送"
                                         GroupName="TransferTabs"
                                         IsChecked="True"
                                         Style="{StaticResource TransferTabStyle}"
                                         Checked="TransferTab_Checked" />
                            <RadioButton x:Name="ReceiveTabButton"
                                         Content="接收"
                                         GroupName="TransferTabs"
                                         Style="{StaticResource TransferTabStyle}"
                                         Checked="TransferTab_Checked" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="WorkspaceHintText"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Text="拖入文件即可加入发送队列" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <!-- 发送 -->
                    <Grid x:Name="SendPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SectionTitleText}"
                                           Text="传输队列"
                                           VerticalAlignment="Center" />
                                <TextBlock Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding EmptyDirectorySummary}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource TinyText}">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowEmptyDirectorySummary}"
                                                             Value="True">
                                                    <Setter Property="Visibility"
                                                            Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button x:Name="AddQueueFilesButton"
                                        Content="添加文件…"
                                        Style="{StaticResource SmallButtonStyle}"
                                        Click="AddQueueFilesButton_Click" />
                                <Button x:Name="AddQueueFolderButton"
                                        Margin="6,0,0,0"
                                        Content="添加文件夹…"
                                        Style="{StaticResource SmallButtonStyle}"
                                        Click="AddQueueFolderButton_Click" />
                                <Button x:Name="StartQueueButton"
                                        Margin="6,0,0,0"
                                        Content="开始传输"
                                        Style="{StaticResource SmallPrimaryButtonStyle}"
                                        Click="StartQueueButton_Click" />
                                <Button x:Name="PauseQueueButton"
                                        Margin="6,0,0,0"
                                        Content="暂停"
                                        Style="{StaticResource SmallSubtleButtonStyle}"
                                        Click="PauseQueueButton_Click" />
                                <Button x:Name="ClearQueueButton"
                                        Margin="4,0,0,0"
                                        Content="清空"
                                        Style="{StaticResource SmallSubtleButtonStyle}"
                                        Click="ClearQueueButton_Click" />
                                <Button x:Name="QueueDetailsToggleButton"
                                        Margin="2,0,0,0"
                                        Content="详情"
                                        Style="{StaticResource SmallSubtleButtonStyle}"
                                        ToolTip="展开或收起当前传输详情"
                                        Click="QueueDetailsToggleButton_Click" />
                            </StackPanel>
                        </Grid>

                        <Border x:Name="QueueProgressCard"
                                Grid.Row="1"
                                Margin="0,0,0,10"
                                Padding="14"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentPositionText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="11.5" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentFile, FallbackValue={x:Null}}"
                                                                     Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Margin="6,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Text="·">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentFile, FallbackValue={x:Null}}"
                                                                     Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock MaxWidth="420"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="{Binding CurrentFile.DisplayPath, TargetNullValue=尚未开始, FallbackValue=尚未开始}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding CurrentFile.SourcePath}" />
                                    </StackPanel>
                                    <TextBlock HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource CurrentStatusTextStyle}"
                                               Text="{Binding CurrentFile.StatusText, TargetNullValue=等待添加文件, FallbackValue=等待添加文件}" />
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentFile, FallbackValue={x:Null}}"
                                                             Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Style="{StaticResource TinyText}"
                                                       Text="当前文件" />
                                            <TextBlock HorizontalAlignment="Right"
                                                       Style="{StaticResource TinyText}"
                                                       Text="{Binding CurrentFile.ProgressPercent, StringFormat={}{0:0}%}" />
                                        </Grid>
                                        <ProgressBar Height="6"
                                                     Margin="0,4,0,0"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding CurrentFile.ProgressPercent, Mode=OneWay, FallbackValue=0}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Style="{StaticResource TinyText}"
                                                   Text="{Binding CurrentFile.TransferRateText, TargetNullValue=—, FallbackValue=—}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Grid>
                                            <TextBlock Style="{StaticResource TinyText}"
                                                       Text="总体进度" />
                                            <TextBlock HorizontalAlignment="Right"
                                                       Style="{StaticResource TinyText}"
                                                       Text="{Binding OverallProgressText}" />
                                        </Grid>
                                        <ProgressBar Height="6"
                                                     Margin="0,4,0,0"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding OverallProgressPercent, Mode=OneWay}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Style="{StaticResource TinyText}"
                                                   Text="{Binding OverallTransferText, TargetNullValue=—, FallbackValue=—}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="31" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0"
                                          Background="{DynamicResource SurfaceAltBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="1" Margin="12,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="116" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center"
                                                       Style="{StaticResource TinyText}"
                                                       Text="项目" />
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource TinyText}"
                                                       Text="大小" />
                                            <TextBlock Grid.Column="2"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource TinyText}"
                                                       Text="状态" />
                                            <TextBlock Grid.Column="3"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource TinyText}"
                                                       Text="进度" />
                                        </Grid>
                                    </Grid>

                                    <Grid Grid.Row="1">
                                        <ListBox x:Name="QueueList"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 ItemContainerStyle="{StaticResource QueueListItemStyle}"
                                                 ItemsSource="{Binding Groups}"
                                                 SelectionChanged="QueueList_SelectionChanged"
                                                 PreviewMouseRightButtonDown="QueueList_PreviewMouseRightButtonDown"
                                                 ContextMenuOpening="QueueList_ContextMenuOpening"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem x:Name="ViewQueueItemDetailsMenuItem"
                                                              Header="查看详情"
                                                              Click="ViewQueueItemDetailsMenuItem_Click" />
                                                    <Separator />
                                                    <MenuItem x:Name="MoveQueueUpMenuItem"
                                                              Header="上移"
                                                              Click="MoveQueueUpMenuItem_Click" />
                                                    <MenuItem x:Name="MoveQueueDownMenuItem"
                                                              Header="下移"
                                                              Click="MoveQueueDownMenuItem_Click" />
                                                    <MenuItem x:Name="RemoveQueueItemMenuItem"
                                                              Header="从队列移除"
                                                              Click="RemoveQueueItemMenuItem_Click" />
                                                </ContextMenu>
                                            </ListBox.ContextMenu>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource RowSeparatorBrush}"
                                                            BorderThickness="0,0,0,1">
                                                        <Grid Height="48" Margin="12,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="64" />
                                                                <ColumnDefinition Width="72" />
                                                                <ColumnDefinition Width="116" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid VerticalAlignment="Center">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="24"
                                                                        Height="24"
                                                                        Background="{DynamicResource IconBackgroundBrush}"
                                                                        CornerRadius="7">
                                                                    <Grid>
                                                                        <Path Data="{StaticResource FolderIconGeometry}">
                                                                            <Path.Style>
                                                                                <Style TargetType="Path"
                                                                                       BasedOn="{StaticResource SmallGlyphPath}">
                                                                                    <Setter Property="Visibility"
                                                                                            Value="Collapsed" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsFolder}"
                                                                                                     Value="True">
                                                                                            <Setter Property="Visibility"
                                                                                                    Value="Visible" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Path.Style>
                                                                        </Path>
                                                                        <Path Data="{StaticResource FileIconGeometry}">
                                                                            <Path.Style>
                                                                                <Style TargetType="Path"
                                                                                       BasedOn="{StaticResource SmallGlyphPath}">
                                                                                    <Setter Property="Visibility"
                                                                                            Value="Visible" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsFolder}"
                                                                                                     Value="True">
                                                                                            <Setter Property="Visibility"
                                                                                                    Value="Collapsed" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Path.Style>
                                                                        </Path>
                                                                    </Grid>
                                                                </Border>
                                                                <StackPanel Grid.Column="1"
                                                                            Margin="8,0,0,0"
                                                                            VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                               FontSize="12"
                                                                               FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               ToolTip="{Binding SourcePath}" />
                                                                    <TextBlock Margin="0,2,0,0"
                                                                               FontSize="10"
                                                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                                                               Text="{Binding Subtitle}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </Grid>
                                                            <TextBlock Grid.Column="1"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="10.5"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       Text="{Binding Size, Converter={StaticResource ByteSizeConverter}}" />
                                                            <TextBlock Grid.Column="2"
                                                                       VerticalAlignment="Center"
                                                                       Style="{StaticResource QueueStatusTextStyle}"
                                                                       Text="{Binding StatusText}" />
                                                            <Grid Grid.Column="3" VerticalAlignment="Center">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <ProgressBar Height="4"
                                                                             VerticalAlignment="Center"
                                                                             Maximum="100"
                                                                             Minimum="0"
                                                                             Style="{StaticResource QueueProgressBarStyle}"
                                                                             Value="{Binding ProgressPercent, Mode=OneWay}" />
                                                                <TextBlock Grid.Column="1"
                                                                           Width="34"
                                                                           Margin="8,0,0,0"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="10"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           Text="{Binding ProgressText}"
                                                                           TextAlignment="Right" />
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                    </Grid>

                                    <Grid x:Name="QueueEmptyPanel"
                                          Grid.RowSpan="2"
                                          Background="{DynamicResource SurfaceBrush}">
                                        <Border Margin="14"
                                                Padding="18"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                BorderBrush="{DynamicResource AccentLineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12">
                                            <StackPanel Width="420"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <Border Width="54"
                                                        Height="54"
                                                        HorizontalAlignment="Center"
                                                        Background="{DynamicResource SurfaceBrush}"
                                                        BorderBrush="{DynamicResource AccentLineBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="14">
                                                    <Path Width="26"
                                                          Height="26"
                                                          Data="{StaticResource FolderAddGlyph}"
                                                          Fill="Transparent"
                                                          Stretch="Uniform"
                                                          Stroke="{DynamicResource AccentBrush}"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          StrokeStartLineCap="Round"
                                                          StrokeThickness="1.5" />
                                                </Border>
                                                <TextBlock x:Name="QueueEmptyText"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,14,0,0"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Text="拖入文件或文件夹开始发送" />
                                                <TextBlock x:Name="QueueEmptyHintText"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,6,0,0"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="支持整组发送，文件夹会保留目录结构；也可以继续往队列里追加"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap" />
                                                <StackPanel Margin="0,16,0,0"
                                                            HorizontalAlignment="Center"
                                                            Orientation="Horizontal">
                                                    <Button Content="添加文件夹…"
                                                            IsEnabled="{Binding IsEnabled, ElementName=AddQueueFolderButton}"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Click="AddQueueFolderButton_Click" />
                                                    <Button Margin="8,0,0,0"
                                                            Content="添加文件…"
                                                            IsEnabled="{Binding IsEnabled, ElementName=AddQueueFilesButton}"
                                                            Style="{StaticResource PrimaryButtonStyle}"
                                                            Click="AddQueueFilesButton_Click" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border x:Name="QueueDetailsPanel"
                                    Grid.Column="1"
                                    Width="220"
                                    Margin="12,0,0,0"
                                    Padding="14"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Visibility="Collapsed">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Style="{StaticResource SectionTitleText}"
                                                       Text="项目详情" />
                                            <TextBlock HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource CurrentStatusTextStyle}"
                                                       Text="{Binding DetailsGroup.StatusText, TargetNullValue=未选择, FallbackValue=未选择}" />
                                        </Grid>
                                        <TextBlock Margin="0,10,0,0"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding DetailsGroup.DisplayPath, TargetNullValue=未选择, FallbackValue=未选择}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Style="{StaticResource TinyText}"
                                                   Text="{Binding DetailsGroup.SourcePath, TargetNullValue=选择队列中的项目或开始传输后显示路径, FallbackValue=选择队列中的项目或开始传输后显示路径}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,10,0,0"
                                                   Text="选择队列中的项目，或开始传输后查看详情。">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TinyText}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DetailsGroup, FallbackValue={x:Null}}"
                                                                     Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <StackPanel x:Name="QueueDetailsFields">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DetailsGroup, FallbackValue={x:Null}}"
                                                                     Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <ProgressBar Height="6"
                                                         Margin="0,10,0,0"
                                                         Maximum="100"
                                                         Minimum="0"
                                                         Value="{Binding DetailsGroup.ProgressPercent, Mode=OneWay, FallbackValue=0}" />

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Style="{StaticResource TinyText}" Text="大小" />
                                            <TextBlock Grid.Column="1"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding DetailsGroup.Size, Converter={StaticResource ByteSizeConverter}, TargetNullValue=—}" />
                                            <TextBlock Grid.Row="1"
                                                       Margin="0,7,0,0"
                                                       Style="{StaticResource TinyText}"
                                                       Text="已发送" />
                                            <TextBlock Grid.Row="1"
                                                       Grid.Column="1"
                                                       Margin="0,7,0,0"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding DetailsGroup.BytesTransferred, Converter={StaticResource ByteSizeConverter}, TargetNullValue=—}" />
                                            <TextBlock Grid.Row="2"
                                                       Margin="0,7,0,0"
                                                       Style="{StaticResource TinyText}"
                                                       Text="速率" />
                                            <TextBlock Grid.Row="2"
                                                       Grid.Column="1"
                                                       Margin="0,7,0,0"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding DetailsGroup.SpeedText, TargetNullValue=—}" />
                                            <TextBlock Grid.Row="3"
                                                       Margin="0,7,0,0"
                                                       Style="{StaticResource TinyText}"
                                                       Text="预计剩余" />
                                            <TextBlock Grid.Row="3"
                                                       Grid.Column="1"
                                                       Margin="0,7,0,0"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding DetailsGroup.EtaText, TargetNullValue=—}" />
                                            <TextBlock Grid.Row="4"
                                                       Margin="0,7,0,0"
                                                       Style="{StaticResource TinyText}"
                                                       Text="续传偏移" />
                                            <TextBlock Grid.Row="4"
                                                       Grid.Column="1"
                                                       Margin="0,7,0,0"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding DetailsGroup.StartOffsetText, TargetNullValue=—}" />
                                            <TextBlock Grid.Row="5"
                                                       Margin="0,7,0,0"
                                                       Style="{StaticResource TinyText}"
                                                       Text="队列位置" />
                                            <TextBlock Grid.Row="5"
                                                       Grid.Column="1"
                                                       Margin="0,7,0,0"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding DetailsGroupPositionText, TargetNullValue=—}" />
                                            <TextBlock Grid.Row="6"
                                                       Margin="0,7,0,0"
                                                       Style="{StaticResource TinyText}"
                                                       Text="文件数" />
                                            <TextBlock Grid.Row="6"
                                                       Grid.Column="1"
                                                       Margin="0,7,0,0"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding DetailsGroup.FileCount, TargetNullValue=—}" />
                                            <TextBlock Grid.Row="7"
                                                       Margin="0,7,0,0"
                                                       Style="{StaticResource TinyText}"
                                                       Text="结果" />
                                            <TextBlock Grid.Row="7"
                                                       Grid.Column="1"
                                                       Margin="0,7,0,0"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding DetailsGroup.ResultText, TargetNullValue=—}" />
                                        </Grid>
                                        </StackPanel>

                                        <TextBlock Margin="0,10,0,0"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   Text="{Binding DetailsGroup.ErrorMessage}"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DetailsGroup.ErrorMessage}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- 接收 -->
                    <Grid x:Name="ReceivePanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border x:Name="CurrentReceivePanel"
                                Margin="0,0,0,10"
                                Padding="14"
                                Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource AccentLineBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6"
                                             Height="6"
                                             Margin="0,0,6,0"
                                             VerticalAlignment="Center"
                                             Fill="{DynamicResource AccentBrush}" />
                                    <TextBlock FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Text="正在接收" />
                                </StackPanel>
                                <TextBlock Grid.Row="1"
                                           Margin="0,4,0,0"
                                           Text="{Binding DisplayPath}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="2"
                                           Margin="0,4,0,0"
                                           Text="{Binding DetailText}"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <ProgressBar Grid.Row="3"
                                             Height="6"
                                             Margin="0,7,0,0"
                                             Maximum="100"
                                             Minimum="0"
                                             Value="{Binding ProgressPercent, Mode=OneWay}" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource SectionTitleText}"
                                           Text="本次接收项目"
                                           VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <TextBlock Margin="0,0,8,0"
                                               VerticalAlignment="Center"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Text="可拖出到资源管理器" />
                                    <Button x:Name="OpenReceivedFolderButton"
                                            Content="打开所在文件夹"
                                            IsEnabled="False"
                                            Style="{StaticResource SmallButtonStyle}"
                                            Click="OpenReceivedFolderButton_Click" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <Grid>
                                    <ListBox x:Name="ReceivedFilesList"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ItemContainerStyle="{StaticResource ReceivedListItemStyle}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             SelectionMode="Extended"
                                             SelectionChanged="ReceivedFilesList_SelectionChanged"
                                             PreviewMouseLeftButtonDown="ReceivedFilesList_PreviewMouseLeftButtonDown"
                                             PreviewMouseLeftButtonUp="ReceivedFilesList_PreviewMouseLeftButtonUp"
                                             MouseMove="ReceivedFilesList_MouseMove"
                                             MouseDoubleClick="ReceivedFilesList_MouseDoubleClick">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource RowSeparatorBrush}"
                                                        BorderThickness="0,0,0,1">
                                                    <Grid Height="50" Margin="12,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="26"
                                                                Height="26"
                                                                VerticalAlignment="Center"
                                                                Background="{DynamicResource IconBackgroundBrush}"
                                                                CornerRadius="8">
                                                            <Grid>
                                                                <Path Data="{StaticResource FolderIconGeometry}">
                                                                    <Path.Style>
                                                                        <Style TargetType="Path"
                                                                               BasedOn="{StaticResource SmallGlyphPath}">
                                                                            <Setter Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsFolder}"
                                                                                             Value="True">
                                                                                    <Setter Property="Visibility"
                                                                                            Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Path.Style>
                                                                </Path>
                                                                <Path Data="{StaticResource FileIconGeometry}">
                                                                    <Path.Style>
                                                                        <Style TargetType="Path"
                                                                               BasedOn="{StaticResource SmallGlyphPath}">
                                                                            <Setter Property="Visibility"
                                                                                    Value="Visible" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsFolder}"
                                                                                             Value="True">
                                                                                    <Setter Property="Visibility"
                                                                                            Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Path.Style>
                                                                </Path>
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Grid.Column="1"
                                                                    Margin="9,0,0,0"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding SourcePath}" />
                                                            <TextBlock Margin="0,2,0,0"
                                                                       FontSize="10"
                                                                       Text="{Binding Subtitle}"
                                                                       TextTrimming="CharacterEllipsis">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2"
                                                                    Margin="10,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding StatusText}"
                                                                       FontSize="10.5"
                                                                       FontWeight="SemiBold"
                                                                       TextAlignment="Right">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding StatusText}" Value="接收中">
                                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding StatusText}" Value="已接收">
                                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding StatusText}" Value="空文件夹已创建">
                                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Margin="0,2,0,0"
                                                                       FontSize="9.5"
                                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                                       Text="{Binding LastActivityText}"
                                                                       TextAlignment="Right" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <StackPanel x:Name="ReceivedFilesEmptyPanel"
                                                Width="340"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsHitTestVisible="False">
                                        <Border Width="40"
                                                Height="40"
                                                HorizontalAlignment="Center"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                CornerRadius="10">
                                            <Path Width="20"
                                                  Height="20"
                                                  Data="{StaticResource FolderIconGeometry}"
                                                  Fill="Transparent"
                                                  Stretch="Uniform"
                                                  Stroke="{DynamicResource AccentBrush}"
                                                  StrokeThickness="1.3" />
                                        </Border>
                                        <TextBlock x:Name="ReceivedFilesEmptyText"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,10,0,0"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Text="暂无接收文件" />
                                        <TextBlock HorizontalAlignment="Center"
                                                   Margin="0,5,0,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Text="接收完成后会显示在这里，可直接拖到资源管理器"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <Border x:Name="LogPanel"
                        Grid.Row="2"
                        Margin="0,14,0,10"
                        Padding="14"
                        Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource SectionTitleText}"
                                       Text="日志"
                                       VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button x:Name="HistoryButton"
                                        Content="传输历史"
                                        Style="{StaticResource SmallSubtleButtonStyle}"
                                        ToolTip="查看传输历史"
                                        Click="HistoryButton_Click" />
                                <Button x:Name="ExportDiagnosticsButton"
                                        Margin="2,0,0,0"
                                        Content="诊断"
                                        Style="{StaticResource SmallSubtleButtonStyle}"
                                        ToolTip="导出日志、设置和构建信息"
                                        Click="ExportDiagnosticsButton_Click" />
                                <Button x:Name="AboutButton"
                                        Margin="2,0,0,0"
                                        Content="关于"
                                        Style="{StaticResource SmallSubtleButtonStyle}"
                                        Click="AboutButton_Click" />
                                <Button x:Name="ClearLogButton"
                                        Margin="2,0,0,0"
                                        Content="清空"
                                        Style="{StaticResource SmallSubtleButtonStyle}"
                                        ToolTip="清空界面日志"
                                        Click="ClearLogButton_Click" />
                                <Button x:Name="LogToggleButton"
                                        Margin="4,0,0,0"
                                        Content="折叠"
                                        Style="{StaticResource SmallSubtleButtonStyle}"
                                        ToolTip="折叠或展开日志"
                                        Click="LogToggleButton_Click" />
                            </StackPanel>
                        </Grid>

                        <TextBox x:Name="LogTextBox"
                                 Grid.Row="1"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 Style="{StaticResource LogTextBoxStyle}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- 未连接首页：引导选择连接方式 -->
            <Grid x:Name="OnboardingPanel"
                  Grid.ColumnSpan="2"
                  Background="{DynamicResource WindowBackgroundBrush}">
                <ScrollViewer x:Name="OnboardingScrollViewer"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <Grid MinHeight="{Binding ViewportHeight, ElementName=OnboardingScrollViewer}">
                        <StackPanel Width="880"
                                    Margin="0,16"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center"
                                Orientation="Horizontal">
                        <Ellipse Width="6"
                                 Height="6"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 Fill="{DynamicResource AccentBrush}" />
                        <TextBlock FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="无需网络 · 点对点直连" />
                    </StackPanel>
                    <TextBlock Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Text="开始 Wi-Fi Direct 传输" />
                    <TextBlock Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               FontSize="12.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="在两台 Windows 电脑之间直接传输文件，不经过云端。首次使用选择一种连接方式，两端操作即可建立加密链路。"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />

                    <Grid Margin="0,26,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource CardBorderStyle}"
                                Padding="24,22">
                            <StackPanel>
                                <Border Width="48"
                                        Height="48"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        CornerRadius="14">
                                    <Path Width="24"
                                          Height="24"
                                          Data="{StaticResource WaitIconGeometry}"
                                          Fill="Transparent"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource AccentBrush}"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="1.5" />
                                </Border>
                                <TextBlock Margin="0,16,0,0"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Text="等待连接" />
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="让对端电脑发现本机。保持窗口打开，发送端扫描后即可发起连接。"
                                           TextWrapping="Wrap" />
                                <StackPanel Margin="0,16,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="20"
                                                Height="20"
                                                Background="{DynamicResource SegmentBackgroundBrush}"
                                                CornerRadius="10">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Text="1" />
                                        </Border>
                                        <TextBlock Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="点击下方按钮开始广播" />
                                    </StackPanel>
                                    <StackPanel Margin="0,9,0,0" Orientation="Horizontal">
                                        <Border Width="20"
                                                Height="20"
                                                Background="{DynamicResource SegmentBackgroundBrush}"
                                                CornerRadius="10">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Text="2" />
                                        </Border>
                                        <TextBlock Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="让对端扫描并选择本机" />
                                    </StackPanel>
                                    <StackPanel Margin="0,9,0,0" Orientation="Horizontal">
                                        <Border Width="20"
                                                Height="20"
                                                Background="{DynamicResource SegmentBackgroundBrush}"
                                                CornerRadius="10">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Text="3" />
                                        </Border>
                                        <TextBlock Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="确认 6 位配对码后接受" />
                                    </StackPanel>
                                </StackPanel>
                                <Button x:Name="OnboardingWaitButton"
                                        Height="40"
                                        Margin="0,20,0,0"
                                        Content="开始等待连接"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="OnboardingWaitButton_Click" />
                                <TextBlock Margin="0,8,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Text="适合作为接收端" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource CardBorderStyle}"
                                Padding="24,22">
                            <StackPanel>
                                <Border Width="48"
                                        Height="48"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource SegmentBackgroundBrush}"
                                        CornerRadius="14">
                                    <Path Width="24"
                                          Height="24"
                                          Data="{StaticResource DeviceIconGeometry}"
                                          Fill="Transparent"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource TextSecondaryBrush}"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="1.5" />
                                </Border>
                                <TextBlock Margin="0,16,0,0"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Text="连接设备" />
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="扫描附近正在等待连接的电脑，选择设备后发起连接。"
                                           TextWrapping="Wrap" />
                                <StackPanel Margin="0,16,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="20"
                                                Height="20"
                                                Background="{DynamicResource SegmentBackgroundBrush}"
                                                CornerRadius="10">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Text="1" />
                                        </Border>
                                        <TextBlock Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="扫描附近设备" />
                                    </StackPanel>
                                    <StackPanel Margin="0,9,0,0" Orientation="Horizontal">
                                        <Border Width="20"
                                                Height="20"
                                                Background="{DynamicResource SegmentBackgroundBrush}"
                                                CornerRadius="10">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Text="2" />
                                        </Border>
                                        <TextBlock Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="选择对端并连接" />
                                    </StackPanel>
                                    <StackPanel Margin="0,9,0,0" Orientation="Horizontal">
                                        <Border Width="20"
                                                Height="20"
                                                Background="{DynamicResource SegmentBackgroundBrush}"
                                                CornerRadius="10">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Text="3" />
                                        </Border>
                                        <TextBlock Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="确认配对码后开始传输" />
                                    </StackPanel>
                                </StackPanel>
                                <Button x:Name="OnboardingScanButton"
                                        Height="40"
                                        Margin="0,20,0,0"
                                        Content="扫描附近设备"
                                        Click="OnboardingScanButton_Click" />
                                <TextBlock Margin="0,8,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Text="适合主动发起传输" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="OnboardingCapabilityText"
                               Margin="0,14,0,0"
                               HorizontalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />

                    <StackPanel Margin="0,22,0,0"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28"
                                    Height="28"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Path Width="14"
                                      Height="14"
                                      Data="{StaticResource ShieldIconGeometry}"
                                      Fill="Transparent"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource TextSecondaryBrush}"
                                      StrokeLineJoin="Round"
                                      StrokeThickness="1.2" />
                            </Border>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Text="链路加密" />
                                <TextBlock FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Text="Wi-Fi Direct 直连" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="28,0,0,0" Orientation="Horizontal">
                            <Border Width="28"
                                    Height="28"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Path Width="14"
                                      Height="14"
                                      Data="{StaticResource ResumeIconGeometry}"
                                      Fill="Transparent"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource TextSecondaryBrush}"
                                      StrokeLineJoin="Round"
                                      StrokeThickness="1.2" />
                            </Border>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Text="断点续传" />
                                <TextBlock FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Text="中断后可恢复" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="28,0,0,0" Orientation="Horizontal">
                            <Border Width="28"
                                    Height="28"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Path Width="14"
                                      Height="14"
                                      Data="{StaticResource CheckIconGeometry}"
                                      Fill="Transparent"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource TextSecondaryBrush}"
                                      StrokeLineJoin="Round"
                                      StrokeThickness="1.2" />
                            </Border>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Text="完整性校验" />
                                <TextBlock FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Text="SHA-256 校验" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="3"
                Background="{DynamicResource StatusBarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="未连接"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ProtocolVersionText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="10.5"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Text="双向传输" />
            </Grid>
        </Border>
    </Grid>
    </Border>
</Window>
