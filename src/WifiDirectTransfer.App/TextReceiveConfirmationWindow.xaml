<Window x:Class="WifiDirectTransfer.App.TextReceiveConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="启用接收远程文本"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="500"
        Height="300"
        MinWidth="460"
        MinHeight="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Style="{StaticResource DialogWindowStyle}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource DialogTitleText}"
                   Text="启用接收远程文本" />

        <Border Grid.Row="1"
                Margin="0,12,0,0"
                Style="{StaticResource DialogWarningBorder}">
            <TextBlock FontSize="12.5"
                       Foreground="{StaticResource WarningBrush}"
                       Text="启用后，对端可以向你发送文本消息，内容会显示在本机的文本收件箱中。"
                       TextWrapping="Wrap" />
        </Border>

        <TextBlock Grid.Row="2"
                   Margin="0,12,0,0"
                   Style="{StaticResource DialogBodyText}"
                   Text="文本不会自动输入到其他程序，也不会自动覆盖剪贴板。敏感内容请谨慎接收。" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="CancelButton"
                    Content="取消"
                    IsCancel="True"
                    MinWidth="88"
                    Margin="0,0,8,0"
                    Click="CancelButton_Click" />
            <Button x:Name="EnableButton"
                    Content="启用"
                    MinWidth="88"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="EnableButton_Click" />
        </StackPanel>
    </Grid>
</Window>
