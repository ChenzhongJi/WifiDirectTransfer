<Window x:Class="WifiDirectTransfer.App.TextReceiveConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="启用接收远程文本"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="500"
        Height="300"
        MinWidth="460"
        MinHeight="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F3F3F3"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="启用接收远程文本"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="#1B1B1B" />

        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Padding="16"
                Background="#FFF7E6"
                BorderBrush="#F0C36D"
                BorderThickness="1"
                CornerRadius="8">
            <TextBlock Text="启用后，对端可以向你发送文本消息，内容会显示在本机的文本收件箱中。"
                       FontSize="14"
                       Foreground="#7A4D00"
                       TextWrapping="Wrap" />
        </Border>

        <TextBlock Grid.Row="2"
                   Margin="0,14,0,0"
                   Foreground="#707070"
                   TextWrapping="Wrap"
                   Text="文本不会自动输入到其他程序，也不会自动覆盖剪贴板。敏感内容请谨慎接收。" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="CancelButton"
                    Content="取消"
                    IsCancel="True"
                    MinWidth="88"
                    Padding="16,6"
                    Margin="0,0,8,0"
                    Click="CancelButton_Click" />
            <Button x:Name="EnableButton"
                    Content="启用"
                    MinWidth="88"
                    Padding="16,6"
                    Click="EnableButton_Click" />
        </StackPanel>
    </Grid>
</Window>
