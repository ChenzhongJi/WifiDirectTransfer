<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Light.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="AccentLineBrush" Color="{x:Static SystemColors.ControlDarkColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="WarningLineBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="PressedBrush" Color="{x:Static SystemColors.ControlDarkColor}" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="DisabledSurfaceBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="RowSeparatorBrush" Color="{x:Static SystemColors.ControlDarkColor}" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="WindowControlGlyphBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="SegmentBackgroundBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="IconBackgroundBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="IconStrokeBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="StatusBarBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="AccentFocusBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="PrimaryDisabledBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="DangerPressedBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="DangerLineBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="SegmentHoverBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="TabHoverBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="QueueHoverBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="QueueActiveBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="LogTextBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{x:Static SystemColors.ControlDarkColor}" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="{x:Static SystemColors.InfoColor}" />
    <SolidColorBrush x:Key="ToolTipForegroundBrush" Color="{x:Static SystemColors.InfoTextColor}" />
</ResourceDictionary>
