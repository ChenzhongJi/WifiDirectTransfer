<Window x:Class="WifiDirectTransfer.App.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="传输历史"
        Width="880"
        Height="540"
        MinWidth="720"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F3F3F3"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="传输历史"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#1B1B1B" />
            <TextBlock x:Name="CountText"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Foreground="#707070" />
        </Grid>

        <Border Grid.Row="1"
                Margin="0,14,0,0"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <ListView x:Name="HistoryList"
                          Margin="6"
                          BorderThickness="0"
                          Background="Transparent"
                          SelectionChanged="HistoryList_SelectionChanged"
                          MouseDoubleClick="HistoryList_MouseDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="时间"
                                            Width="140"
                                            DisplayMemberBinding="{Binding TimeText}" />
                            <GridViewColumn Header="方向"
                                            Width="55"
                                            DisplayMemberBinding="{Binding DirectionText}" />
                            <GridViewColumn Header="文件名"
                                            Width="280"
                                            DisplayMemberBinding="{Binding FileName}" />
                            <GridViewColumn Header="大小"
                                            Width="85"
                                            DisplayMemberBinding="{Binding SizeText}" />
                            <GridViewColumn Header="结果"
                                            Width="70">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding OutcomeText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#707070" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Outcome}" Value="Completed">
                                                            <Setter Property="Foreground" Value="#1B7F3B" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Outcome}" Value="Failed">
                                                            <Setter Property="Foreground" Value="#B3261E" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Outcome}" Value="Skipped">
                                                            <Setter Property="Foreground" Value="#9A6700" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="对端"
                                            Width="140"
                                            DisplayMemberBinding="{Binding PeerText}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <TextBlock x:Name="EmptyText"
                           Text="暂无传输记录"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#8A8A8A"
                           Visibility="Collapsed" />
            </Grid>
        </Border>

        <TextBlock x:Name="DetailText"
                   Grid.Row="2"
                   Margin="0,10,0,0"
                   MinHeight="18"
                   Foreground="#707070"
                   TextWrapping="Wrap" />

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="OpenFolderButton"
                        Content="打开所在文件夹"
                        MinWidth="130"
                        Padding="16,6"
                        IsEnabled="False"
                        Click="OpenFolderButton_Click" />
                <Button x:Name="ClearHistoryButton"
                        Margin="8,0,0,0"
                        Content="清空历史"
                        MinWidth="96"
                        Padding="16,6"
                        Click="ClearHistoryButton_Click" />
            </StackPanel>

            <Button HorizontalAlignment="Right"
                    Content="关闭"
                    IsCancel="True"
                    MinWidth="88"
                    Padding="16,6" />
        </Grid>
    </Grid>
</Window>
