<Window x:Class="WifiDirectTransfer.App.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="传输历史"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="920"
        Height="540"
        MinWidth="780"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Style="{StaticResource DialogWindowStyle}">
    <Window.Resources>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <Thumb x:Name="PART_HeaderGripper"
                                   Width="8"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Stretch"
                                   Cursor="SizeWE">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RowSeparatorBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}"
                                                  Content="{TemplateBinding Content}"
                                                  SnapsToDevicePixels="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Style="{StaticResource DialogTitleText}"
                       Text="传输历史" />
            <TextBlock x:Name="CountText"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Style="{StaticResource DialogSubtitleText}" />
        </Grid>

        <Border Grid.Row="1"
                Margin="0,12,0,0"
                Style="{StaticResource DialogListBorder}">
            <Grid>
                <ListView x:Name="HistoryList"
                          BorderThickness="0"
                          Background="Transparent"
                          SelectionChanged="HistoryList_SelectionChanged"
                          MouseDoubleClick="HistoryList_MouseDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="时间"
                                            Width="140"
                                            DisplayMemberBinding="{Binding TimeText}" />
                            <GridViewColumn Header="方向"
                                            Width="50"
                                            DisplayMemberBinding="{Binding DirectionText}" />
                            <GridViewColumn Header="文件名"
                                            Width="220">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FileName}"
                                                   Margin="10,0"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding FileName}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="大小"
                                            Width="80"
                                            DisplayMemberBinding="{Binding SizeText}" />
                            <GridViewColumn Header="平均速度"
                                            Width="90"
                                            DisplayMemberBinding="{Binding SpeedText}" />
                            <GridViewColumn Header="耗时"
                                            Width="70"
                                            DisplayMemberBinding="{Binding DurationText}" />
                            <GridViewColumn Header="结果"
                                            Width="65">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding OutcomeText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Outcome}" Value="Completed">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Outcome}" Value="Failed">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Outcome}" Value="Skipped">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="对端"
                                            Width="100"
                                            DisplayMemberBinding="{Binding PeerText}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <TextBlock x:Name="EmptyText"
                           Text="暂无传输记录"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Visibility="Collapsed" />
            </Grid>
        </Border>

        <TextBlock x:Name="DetailText"
                   Grid.Row="2"
                   Margin="0,10,0,0"
                   MinHeight="18"
                   Style="{StaticResource DialogHintText}" />

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="OpenFolderButton"
                        Content="打开所在文件夹"
                        MinWidth="130"
                        IsEnabled="False"
                        Click="OpenFolderButton_Click" />
                <Button x:Name="ClearHistoryButton"
                        Margin="8,0,0,0"
                        Content="清空历史"
                        MinWidth="96"
                        Style="{StaticResource DangerButtonStyle}"
                        Click="ClearHistoryButton_Click" />
            </StackPanel>

            <Button HorizontalAlignment="Right"
                    Content="关闭"
                    IsCancel="True"
                    MinWidth="88" />
        </Grid>
    </Grid>
</Window>
