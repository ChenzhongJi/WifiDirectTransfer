<Window x:Class="WifiDirectTransfer.App.BackgroundCloseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="传输仍在进行"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="500"
        Height="320"
        MinWidth="460"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Style="{StaticResource DialogWindowStyle}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource DialogTitleText}"
                   Text="传输仍在进行" />

        <Border Grid.Row="1"
                Margin="0,12,0,0"
                Style="{StaticResource DialogWarningBorder}">
            <TextBlock FontSize="12.5"
                       Foreground="{DynamicResource WarningBrush}"
                       Text="当前连接或传输尚未结束。直接关闭窗口会中断传输。"
                       TextWrapping="Wrap" />
        </Border>

        <TextBlock Grid.Row="2"
                   Margin="0,12,0,0"
                   Style="{StaticResource DialogBodyText}"
                   Text="选择“后台继续”会隐藏主窗口，传输在托盘中继续；双击托盘图标可恢复。" />

        <StackPanel Grid.Row="3"
                    Margin="0,14,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="CancelButton"
                    Content="返回"
                    IsCancel="True"
                    MinWidth="88"
                    Margin="0,0,8,0"
                    Click="CancelButton_Click" />
            <Button x:Name="ExitButton"
                    Content="取消传输并退出"
                    MinWidth="132"
                    Margin="0,0,8,0"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="ExitButton_Click" />
            <Button x:Name="BackgroundButton"
                    Content="后台继续"
                    IsDefault="True"
                    MinWidth="100"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="BackgroundButton_Click" />
        </StackPanel>
    </Grid>
</Window>
