<Window x:Class="WifiDirectTransfer.App.DevicePairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设备配对"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="500"
        Height="440"
        MinWidth="460"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Style="{StaticResource DialogWindowStyle}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource DialogTitleText}"
                   Text="设备配对" />

        <TextBlock Grid.Row="1"
                   Margin="0,8,0,0"
                   Style="{StaticResource DialogBodyText}"
                   Text="请确认两台电脑显示的 6 位配对码完全一致。一致才接受，否则请拒绝。" />

        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Style="{StaticResource DialogCardBorder}">
            <StackPanel>
                <TextBlock Style="{StaticResource DialogHintText}"
                           Text="对方设备" />
                <TextBlock x:Name="PeerNameText"
                           Margin="0,4,0,0"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource DialogHintText}"
                           Text="公钥指纹" />
                <TextBlock x:Name="FingerprintText"
                           Margin="0,4,0,0"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="10.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Margin="0,12,0,0"
                Padding="16,10"
                Background="{DynamicResource AccentSoftBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock HorizontalAlignment="Center"
                           Style="{StaticResource DialogHintText}"
                           Text="配对码" />
                <TextBlock x:Name="PairingCodeText"
                           Margin="0,2,0,0"
                           HorizontalAlignment="Center"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="CountdownText"
                   Grid.Row="4"
                   Margin="0,10,0,0"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource WarningBrush}"
                   Text="30 秒后自动拒绝" />

        <StackPanel Grid.Row="5"
                    Margin="0,8,0,0">
            <CheckBox x:Name="TrustCheckBox"
                      Content="信任此设备，以后自动接受连接"
                      IsChecked="True"
                      Style="{StaticResource WdtCheckBoxStyle}" />
            <TextBlock x:Name="TrustHelpText"
                       Margin="24,3,0,0"
                       Style="{StaticResource TinyText}"
                       Text="信任后，该设备再次连接时可跳过手动接收确认，但仍会验证设备密钥。"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="拒绝"
                    IsCancel="True"
                    MinWidth="88"
                    Margin="0,0,8,0"
                    Click="RejectButton_Click" />
            <Button x:Name="AcceptButton"
                    Content="配对码一致，接受"
                    MinWidth="140"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="AcceptButton_Click" />
        </StackPanel>
    </Grid>
</Window>
