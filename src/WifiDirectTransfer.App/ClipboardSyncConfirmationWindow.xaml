<Window x:Class="WifiDirectTransfer.App.ClipboardSyncConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="启用剪贴板同步"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="480"
        Height="270"
        MinWidth="440"
        MinHeight="250"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Style="{StaticResource DialogWindowStyle}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource DialogTitleText}"
                   Text="启用剪贴板同步" />

        <Border Grid.Row="1"
                Margin="0,12,0,0"
                Style="{StaticResource DialogWarningBorder}">
            <TextBlock FontSize="12.5"
                       Foreground="{StaticResource WarningBrush}"
                       Text="启用后，对端将能看到你复制的内容。"
                       TextWrapping="Wrap" />
        </Border>

        <TextBlock Grid.Row="2"
                   Margin="0,12,0,0"
                   Style="{StaticResource DialogBodyText}"
                   Text="剪贴板中的文本和图片会通过当前连接同步到对端。敏感内容请勿在同步开启时复制。" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="CancelButton"
                    Content="取消"
                    IsCancel="True"
                    MinWidth="88"
                    Margin="0,0,8,0"
                    Click="CancelButton_Click" />
            <Button x:Name="EnableButton"
                    Content="启用"
                    MinWidth="88"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="EnableButton_Click" />
        </StackPanel>
    </Grid>
</Window>
