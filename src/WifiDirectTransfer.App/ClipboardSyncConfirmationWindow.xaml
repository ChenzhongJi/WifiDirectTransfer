<Window x:Class="WifiDirectTransfer.App.ClipboardSyncConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="启用剪贴板同步"
        Width="480"
        Height="270"
        MinWidth="440"
        MinHeight="250"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F3F3F3"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="启用剪贴板同步"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="#1B1B1B" />

        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Padding="16"
                Background="#FFF7E6"
                BorderBrush="#F0C36D"
                BorderThickness="1"
                CornerRadius="8">
            <TextBlock Text="启用后，对端将能看到你复制的内容。"
                       FontSize="14"
                       Foreground="#7A4D00"
                       TextWrapping="Wrap" />
        </Border>

        <TextBlock Grid.Row="2"
                   Margin="0,14,0,0"
                   Foreground="#707070"
                   TextWrapping="Wrap"
                   Text="剪贴板中的文本和图片会通过当前连接同步到对端。敏感内容请勿在同步开启时复制。" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="CancelButton"
                    Content="取消"
                    IsCancel="True"
                    MinWidth="88"
                    Padding="16,6"
                    Margin="0,0,8,0"
                    Click="CancelButton_Click" />
            <Button x:Name="EnableButton"
                    Content="启用"
                    MinWidth="88"
                    Padding="16,6"
                    Click="EnableButton_Click" />
        </StackPanel>
    </Grid>
</Window>
